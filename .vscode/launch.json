{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "InvestProMax.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/InvestProMax.Api/bin/Debug/net10.0/InvestProMax.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/InvestProMax.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "InvestProMax.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/InvestProMax.Web/InvestProMax.Web.csproj"],
      "cwd": "${workspaceFolder}/src/InvestProMax.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ],
  "compounds": [
    {
      "name": "Api + Web",
      "configurations": [
        "InvestProMax.Api",
        "InvestProMax.Web"
      ],
      "stopAll": true
    }
  ]
}
