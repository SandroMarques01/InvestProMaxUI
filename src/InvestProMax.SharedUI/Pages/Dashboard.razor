    private sealed record FatiasPizza(TipoPapel Tipo, decimal Valor, double Percentual, string SvgPath, string Cor);

    private static List<FatiasPizza> CalcularFatiasPizza(IReadOnlyList<AlocacaoPorTipoPapel> alocacoes, decimal total)
    {
        var fatias = new List<FatiasPizza>();
        if (total <= 0) return fatias;

        double anguloAtual = 0.0;
        const double cx = 100.0;
        const double cy = 100.0;
        const double r = 85.0;

        foreach (var item in alocacoes)
        {
            if (item.Valor <= 0) continue;
            double pct = (double)(item.Valor / total);
            double deltaAngulo = pct * 360.0;
            double anguloFinal = anguloAtual + deltaAngulo;

            string path;
            if (deltaAngulo >= 359.99)
            {
                path = string.Create(System.Globalization.CultureInfo.InvariantCulture,
                    $"M {cx - r:F1},{cy:F1} a {r:F1},{r:F1} 0 1,0 {r * 2:F1},0 a {r:F1},{r:F1} 0 1,0 {-r * 2:F1},0");
            }
            else
            {
                double rad1 = (anguloAtual - 90.0) * Math.PI / 180.0;
                double rad2 = (anguloFinal - 90.0) * Math.PI / 180.0;

                double x1 = cx + r * Math.Cos(rad1);
                double y1 = cy + r * Math.Sin(rad1);
                double x2 = cx + r * Math.Cos(rad2);
                double y2 = cy + r * Math.Sin(rad2);

                int largeArcFlag = deltaAngulo > 180.0 ? 1 : 0;
                path = string.Create(System.Globalization.CultureInfo.InvariantCulture,
                    $"M {cx:F1} {cy:F1} L {x1:F2} {y1:F2} A {r:F1} {r:F1} 0 {largeArcFlag} 1 {x2:F2} {y2:F2} Z");
            }

            fatias.Add(new FatiasPizza(item.TipoPapel, item.Valor, pct, path, ObterCorTipoPapel(item.TipoPapel)));
            anguloAtual = anguloFinal;
        }

        return fatias;
    }

    private sealed record ItemEvolucao12Meses(int Ano, int Mes, decimal CapitalAcumulado, decimal AporteLiquido, decimal Compras, decimal Vendas);

    private static List<ItemEvolucao12Meses> ObterSerieEvolucao12Meses(
        IReadOnlyList<DividendoPorMes> mesesReferencia,
        IReadOnlyList<EvolucaoCapitalMes> evolucao)
    {
        var resultado = new List<ItemEvolucao12Meses>();
        if (mesesReferencia.Count == 0) return resultado;

        foreach (var refMes in mesesReferencia)
        {
            var itemHistorico = evolucao.LastOrDefault(e => e.Ano < refMes.Ano || (e.Ano == refMes.Ano && e.Mes <= refMes.Mes));
            var itemMesExato = evolucao.FirstOrDefault(e => e.Ano == refMes.Ano && e.Mes == refMes.Mes);

            var capitalAcumulado = itemHistorico?.CapitalAcumulado ?? 0m;
            var aporteLiquido = itemMesExato?.AporteLiquidoNoMes ?? 0m;
            var compras = itemMesExato?.ComprasNoMes ?? 0m;
            var vendas = itemMesExato?.VendasNoMes ?? 0m;

            resultado.Add(new ItemEvolucao12Meses(refMes.Ano, refMes.Mes, capitalAcumulado, aporteLiquido, compras, vendas));
        }

        return resultado;
    }
