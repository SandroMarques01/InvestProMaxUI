@page "/"
@inject IInvestProMaxApiClient ApiClient
@inject NavigationManager Navegacao

<header class="page-header">
    <div>
        <div class="breadcrumb">InvestProMax <Icon Name="chevron" Size="12" /> Dashboard</div>
        <h1>Dashboard</h1>
    </div>
</header>

@if (_mensagemErro is not null && _dashboard is null)
{
    <div class="card state-card">
        <img src="_content/InvestProMax.SharedUI/images/moedas-caindo.gif" alt="Carregando..." class="loading-gif" />
        <h2>Não foi possível carregar o Dashboard</h2>
        <p style="max-width: 520px; margin: 8px auto 18px; color: var(--muted); font-size: 12px; line-height: 1.5;">@_mensagemErro</p>
        <button type="button" class="btn btn-primary" @onclick="CarregarAsync" disabled="@_carregando">
            <Icon Name="refresh" Size="16" /><span>@(_carregando ? "Tentando..." : "Tentar novamente")</span>
        </button>
    </div>
}
else if (_dashboard is null)
{
    <LoadingState Mensagem="Carregando dados do dashboard..." Subtitulo="Aguarde enquanto calculamos os indicadores da sua carteira." />
}
else
{
    @if (_mensagemErro is not null)
    {
        <div class="alerta-erro">@_mensagemErro</div>
    }
    var rendimentoCarteira = _dashboard.TotalInvestidoCarteira > 0
        ? (_dashboard.GanhoTotalCarteira / _dashboard.TotalInvestidoCarteira)
        : 0m;
    var ehPositivo = _dashboard.GanhoTotalCarteira >= 0;

    var hoje = DateOnly.FromDateTime(DateTime.UtcNow);
    var mesAnterior = new DateOnly(hoje.Year, hoje.Month, 1).AddMonths(-1);
    var evolucaoAteMesAnterior = _dashboard.EvolucaoCapital
        .Where(e => e.Ano < mesAnterior.Year || (e.Ano == mesAnterior.Year && e.Mes <= mesAnterior.Month))
        .OrderBy(e => e.Ano)
        .ThenBy(e => e.Mes)
        .LastOrDefault();
    var totalInvestidoAteMesAnterior = evolucaoAteMesAnterior?.CapitalAcumulado ?? 0m;
    var pctDividendoMesSobreInvestidoAnterior = totalInvestidoAteMesAnterior > 0m
        ? (_dashboard.DividendosNoMes / totalInvestidoAteMesAnterior) * 100m
        : 0m;

    <div class="kpi-grid five">
        <!-- 1. Patrimônio total (Mês atual) -->
        <section class="card kpi">
            <div class="kpi-top">
                <span>Patrimônio total (Mês atual)</span>
                <div class="kpi-icon"><Icon Name="assets" Size="16" /></div>
            </div>
            <strong>@FormatarMoeda(_dashboard.PatrimonioTotal)</strong>
            <div class="kpi-meta">
                <span>@(_dashboard.PatrimonioMes is not null ? $"Competência: {_dashboard.PatrimonioMes:00}/{_dashboard.PatrimonioAno}" : "Posição consolidada da carteira")</span>
            </div>
        </section>

        <!-- 2. Total atual (Carteira) -->
        <section class="card kpi">
            <div class="kpi-top">
                <span>Total atual (Carteira)</span>
                <div class="kpi-icon"><Icon Name="papers" Size="16" /></div>
            </div>
            <strong>@FormatarMoeda(_dashboard.TotalAtualCarteira)</strong>
            <div class="kpi-meta">
                <span>Valor a mercado das posições</span>
            </div>
        </section>

        <!-- 3. Total investido (Carteira) -->
        <section class="card kpi">
            <div class="kpi-top">
                <span>Total investido (Carteira)</span>
                <div class="kpi-icon"><Icon Name="transaction" Size="16" /></div>
            </div>
            <strong>@FormatarMoeda(_dashboard.TotalInvestidoCarteira)</strong>
            <div class="kpi-meta">
                <span>Custo das posições em aberto</span>
            </div>
        </section>

        <!-- 4. Ganho / Perda da carteira (contendo valor e porcentagem) -->
        <section class="card kpi">
            <div class="kpi-top">
                <span>Ganho / Perda da carteira</span>
                <div class="kpi-icon @(ehPositivo ? "positive" : "negative")">
                    <Icon Name="papers" Size="16" />
                </div>
            </div>
            <strong class="@(ehPositivo ? "positive" : "negative")">@FormatarMoeda(_dashboard.GanhoTotalCarteira)</strong>
            <div class="kpi-meta @(ehPositivo ? "positive" : "negative")">
                <span>@(ehPositivo ? "+" : "")@rendimentoCarteira.ToString("P2") sobre o custo</span>
            </div>
        </section>

        <!-- 5. Dividendos no mês -->
        <section class="card kpi">
            <div class="kpi-top">
                <span>Dividendos no mês</span>
                <div class="kpi-icon positive"><Icon Name="dividend" Size="16" /></div>
            </div>
            <strong class="positive">@FormatarMoeda(_dashboard.DividendosNoMes)</strong>
            <div class="kpi-meta" style="display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
                <span class="positive" title="Percentual do dividendo do mês pelo valor total investido até o mês anterior (@FormatarMoeda(totalInvestidoAteMesAnterior))">
                    @pctDividendoMesSobreInvestidoAnterior.ToString("N2")% sobre investido até mês ant.
                </span>
                <span>Total histórico: @FormatarMoeda(_dashboard.TotalDividendosHistorico)</span>
            </div>
        </section>
    </div>

    <div class="dashboard-grid">
        <!-- Alocação por tipo (Pizza) -->
        <section class="card allocation">
            <div class="section-title">
                <div>
                    <h2>Alocação por tipo</h2>
                    <p>Distribuição do patrimônio em carteira (Pizza)</p>
                </div>
                @if (_dashboard.AlocacaoPorTipoPapel.Count > 0)
                {
                    <div style="font-size: 11px;">
                        <span style="color: var(--muted);">Total: </span>
                        <strong>@FormatarMoeda(_dashboard.AlocacaoPorTipoPapel.Sum(a => a.Valor))</strong>
                    </div>
                }
            </div>

            @if (_dashboard.AlocacaoPorTipoPapel.Count == 0)
            {
                <div style="padding: 30px; text-align: center; color: var(--muted);">
                    Nenhuma posição ativa em carteira.
                </div>
            }
            else
            {
                var totalAlocado = _dashboard.AlocacaoPorTipoPapel.Sum(a => a.Valor);
                var fatias = CalcularFatiasPizza(_dashboard.AlocacaoPorTipoPapel, totalAlocado);

                <div class="pizza-chart-wrap">
                    <svg viewBox="0 0 200 200" class="pizza-svg" aria-label="Gráfico de pizza da alocação da carteira">
                        @foreach (var fatia in fatias)
                        {
                            <path d="@fatia.SvgPath"
                                  fill="@fatia.Cor"
                                  stroke="var(--surface)"
                                  stroke-width="1.5"
                                  stroke-linejoin="round"
                                  class="pizza-slice">
                                <title>@($"{ObterNomeTipoPapel(fatia.Tipo)}: {FormatarMoeda(fatia.Valor)} ({fatia.Percentual:P1})")</title>
                            </path>
                        }
                    </svg>
                    <div class="chart-legend">
                        @foreach (var item in _dashboard.AlocacaoPorTipoPapel)
                        {
                            var pct = totalAlocado > 0 ? (item.Valor / totalAlocado).ToString("P1") : "0%";
                            <div>
                                <span class="dot" style="background: @ObterCorTipoPapel(item.TipoPapel);"></span>
                                <span>@ObterNomeTipoPapel(item.TipoPapel)</span>
                                <strong>@pct</strong>
                                <span class="legend-val">@FormatarMoeda(item.Valor)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

        <!-- Dividendos recebidos por mês (Coluna) -->
        <section class="card dividends-chart">
            <div class="section-title">
                <div>
                    <h2>Dividendos recebidos</h2>
                    <p>Histórico dos últimos 12 meses (Coluna por mês)</p>
                </div>
                @if (_dashboard.DividendosPorMes.Count > 0)
                {
                    var total12M = _dashboard.DividendosPorMes.Sum(d => d.Total);
                    var media12M = total12M / 12m;
                    <div style="text-align: right; font-size: 11px;">
                        <span style="color: var(--muted);">Total 12M: </span><strong class="positive">@FormatarMoeda(total12M)</strong>
                        <span style="color: var(--muted); margin-left: 8px;">Média: </span><strong>@FormatarMoeda(media12M)/mês</strong>
                    </div>
                }
            </div>

            @{
                var maxDiv = _dashboard.DividendosPorMes.Count > 0 ? _dashboard.DividendosPorMes.Max(d => d.Total) : 0;
                if (maxDiv <= 0) maxDiv = 1;
            }

            <div class="chart-with-grid">
                <div class="chart-y-axis">
                    <div class="grid-line"><span>@FormatarMoedaAbrev(maxDiv)</span></div>
                    <div class="grid-line"><span>@FormatarMoedaAbrev(maxDiv / 2)</span></div>
                    <div class="grid-line"><span>R$ 0</span></div>
                </div>
                <div class="bars-stage">
                    @foreach (var mes in _dashboard.DividendosPorMes)
                    {
                        var ehMesAtual = mes.Ano == hoje.Year && mes.Mes == hoje.Month;
                        var altura = (double)(mes.Total / maxDiv) * 100;
                        var tooltip = $"{mes.Mes:00}/{mes.Ano}: {FormatarMoeda(mes.Total)}";

                        <div class="bar-col @(ehMesAtual ? "is-current" : "")" title="@tooltip">
                            <div class="stack-wrap">
                                @if (mes.Total > 0)
                                {
                                    <div class="stack @(ehMesAtual ? "is-current" : "")"
                                         style="height: @FormatarAlturaCss(altura); background: linear-gradient(180deg, var(--primary-mid) 0%, var(--primary) 100%);">
                                    </div>
                                }
                                else
                                {
                                    <div style="width: 14px; height: 3px; background: var(--line); border-radius: 2px;"></div>
                                }
                            </div>
                            <span>@($"{mes.Mes:00}/{mes.Ano.ToString()[2..]}")</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>

    <div class="dashboard-grid">
        <!-- Aumento de capital investido (Coluna) -->
        <section class="card capital-chart">
            <div class="section-title">
                <div>
                    <h2>Aumento de capital investido</h2>
                    <p>Evolução nos últimos 12 meses (Coluna)</p>
                </div>
                <div class="chart-toggle">
                    <button type="button" class="@(_modoCapitalAcumulado ? "active" : "")" @onclick="() => _modoCapitalAcumulado = true">
                        Capital Acumulado
                    </button>
                    <button type="button" class="@(!_modoCapitalAcumulado ? "active" : "")" @onclick="() => _modoCapitalAcumulado = false">
                        Aportes no Mês
                    </button>
                </div>
            </div>

            @{
                var serie12Meses = ObterSerieEvolucao12Meses(_dashboard.DividendosPorMes, _dashboard.EvolucaoCapital);
                var maxCap = _modoCapitalAcumulado
                    ? (serie12Meses.Count > 0 ? serie12Meses.Max(s => s.CapitalAcumulado) : 0m)
                    : (serie12Meses.Count > 0 ? serie12Meses.Max(s => Math.Max(0m, s.AporteLiquido)) : 0m);
                if (maxCap <= 0) maxCap = 1;
            }

            <div class="chart-with-grid">
                <div class="chart-y-axis">
                    <div class="grid-line"><span>@FormatarMoedaAbrev(maxCap)</span></div>
                    <div class="grid-line"><span>@FormatarMoedaAbrev(maxCap / 2)</span></div>
                    <div class="grid-line"><span>R$ 0</span></div>
                </div>
                <div class="bars-stage">
                    @foreach (var item in serie12Meses)
                    {
                        var ehMesAtual = item.Ano == hoje.Year && item.Mes == hoje.Month;
                        var valorExibido = _modoCapitalAcumulado ? item.CapitalAcumulado : item.AporteLiquido;
                        var altura = (double)(Math.Max(0, valorExibido) / maxCap) * 100;
                        var tooltip = $"{item.Mes:00}/{item.Ano}\nCapital Acumulado: {FormatarMoeda(item.CapitalAcumulado)}\nAporte Líquido: {FormatarMoeda(item.AporteLiquido)}\nCompras: {FormatarMoeda(item.Compras)}\nVendas: {FormatarMoeda(item.Vendas)}";

                        <div class="bar-col @(ehMesAtual ? "is-current" : "")" title="@tooltip">
                            <div class="stack-wrap">
                                @if (valorExibido > 0)
                                {
                                    <div class="stack @(ehMesAtual ? "is-current" : "")"
                                         style="height: @FormatarAlturaCss(altura); background: linear-gradient(180deg, #3fa360 0%, #1e6b3c 100%);">
                                    </div>
                                }
                                else if (valorExibido < 0)
                                {
                                    <div style="width: 14px; height: 6px; background: var(--danger); border-radius: 2px;"></div>
                                }
                                else
                                {
                                    <div style="width: 14px; height: 3px; background: var(--line); border-radius: 2px;"></div>
                                }
                            </div>
                            <span>@($"{item.Mes:00}/{item.Ano.ToString()[2..]}")</span>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Dividendos por tipo (Tabela completa com ordenação e paginação) -->
        <section class="card upcoming">
            <div class="section-title">
                <div>
                    <h2>Dividendos por tipo</h2>
                    <p>Demonstrativo completo somado por tipo por mês</p>
                </div>
                @if (_dashboard.DividendosPorMesETipo.Count > 0)
                {
                    var totalGeral = _dashboard.DividendosPorMesETipo.Sum(d => d.Total);
                    <div style="font-size: 11px;">
                        <span style="color: var(--muted);">Total histórico: </span>
                        <strong class="positive">@FormatarMoeda(totalGeral)</strong>
                    </div>
                }
            </div>

            @if (_dashboard.DividendosPorMesETipo.Count == 0)
            {
                <div style="padding: 30px; text-align: center; color: var(--muted);">
                    Nenhum provento registrado.
                </div>
            }
            else
            {
                var listaOrdenada = ObterDividendosPorTipoOrdenados().ToList();
                var totalRegistrosDiv = listaOrdenada.Count;
                var totalPaginasDiv = Math.Max(1, (int)Math.Ceiling((double)totalRegistrosDiv / TamanhoPaginaPadrao));
                if (_paginaDivTipo > totalPaginasDiv) _paginaDivTipo = totalPaginasDiv;

                var inicioDiv = ((_paginaDivTipo - 1) * TamanhoPaginaPadrao) + 1;
                var fimDiv = Math.Min(_paginaDivTipo * TamanhoPaginaPadrao, totalRegistrosDiv);
                var itensPaginaDiv = listaOrdenada.Skip((_paginaDivTipo - 1) * TamanhoPaginaPadrao).Take(TamanhoPaginaPadrao).ToList();

                var totalAcoes = listaOrdenada.Sum(d => d.Acoes);
                var totalFiis = listaOrdenada.Sum(d => d.Fiis);
                var totalBdrs = listaOrdenada.Sum(d => d.Bdrs);
                var totalEtfs = listaOrdenada.Sum(d => d.Etfs);
                var totalTudo = listaOrdenada.Sum(d => d.Total);

                <div class="table-shell" style="border: 0; box-shadow: none;">
                    <table>
                        <thead>
                            <tr>
                                <th class="alinhar-centro" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("MesAno")'>
                                    Mês/Ano @IndicadorOrdenacaoDivTipo("MesAno")
                                </th>
                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Acoes")'>
                                    Ações @IndicadorOrdenacaoDivTipo("Acoes")
                                </th>
                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Fiis")'>
                                    FIIs @IndicadorOrdenacaoDivTipo("Fiis")
                                </th>
                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Bdrs")'>
                                    BDRs @IndicadorOrdenacaoDivTipo("Bdrs")
                                </th>
                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Etfs")'>
                                    ETFs @IndicadorOrdenacaoDivTipo("Etfs")
                                </th>
                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Total")'>
                                    Total @IndicadorOrdenacaoDivTipo("Total")
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in itensPaginaDiv)
                            {
                                <tr>
                                    <td class="alinhar-centro font-bold">@($"{item.Mes:00}/{item.Ano}")</td>
                                    <td class="alinhar-direita">@(item.Acoes > 0 ? FormatarMoeda(item.Acoes) : "–")</td>
                                    <td class="alinhar-direita">@(item.Fiis > 0 ? FormatarMoeda(item.Fiis) : "–")</td>
                                    <td class="alinhar-direita">@(item.Bdrs > 0 ? FormatarMoeda(item.Bdrs) : "–")</td>
                                    <td class="alinhar-direita">@(item.Etfs > 0 ? FormatarMoeda(item.Etfs) : "–")</td>
                                    <td class="alinhar-direita positive font-bold">@FormatarMoeda(item.Total)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="alinhar-centro font-bold">Total Geral</td>
                                <td class="alinhar-direita">@FormatarMoeda(totalAcoes)</td>
                                <td class="alinhar-direita">@FormatarMoeda(totalFiis)</td>
                                <td class="alinhar-direita">@FormatarMoeda(totalBdrs)</td>
                                <td class="alinhar-direita">@FormatarMoeda(totalEtfs)</td>
                                <td class="alinhar-direita positive font-bold">@FormatarMoeda(totalTudo)</td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="table-footer">
                        <span>Mostrando @inicioDiv–@fimDiv de @totalRegistrosDiv competências</span>
                        <PaginacaoGrid PaginaAtual="_paginaDivTipo" TotalPaginas="totalPaginasDiv" OnPaginaMudou="p => _paginaDivTipo = p" />
                    </div>
                </div>
            }
        </section>
    </div>

    <!-- Top 10 papéis com maior total atual -->
    <section class="card" style="margin-bottom: 18px;">
        <div class="section-title">
            <div>
                <h2>Top 10 papéis com maior total atual</h2>
                <p>Maiores posições ativas da carteira por valor total de mercado</p>
            </div>
            @if (_topPapeis.Count > 0)
            {
                <div style="font-size: 11px;">
                    <span style="color: var(--muted);">Total Top 10: </span>
                    <strong>@FormatarMoeda(_topPapeis.Sum(p => p.ValorTotalAtual))</strong>
                </div>
            }
        </div>

        @if (_topPapeis.Count == 0)
        {
            <div style="padding: 30px; text-align: center; color: var(--muted);">
                Nenhum papel ativo em carteira.
            </div>
        }
        else
        {
            var topOrdenados = ObterTopPapeisOrdenados().ToList();
            var totalTop = topOrdenados.Count;
            var totalPaginasTop = Math.Max(1, (int)Math.Ceiling((double)totalTop / TamanhoPaginaPadrao));
            if (_paginaTopPapeis > totalPaginasTop) _paginaTopPapeis = totalPaginasTop;

            var inicioTop = ((_paginaTopPapeis - 1) * TamanhoPaginaPadrao) + 1;
            var fimTop = Math.Min(_paginaTopPapeis * TamanhoPaginaPadrao, totalTop);
            var itensTopPagina = topOrdenados.Skip((_paginaTopPapeis - 1) * TamanhoPaginaPadrao).Take(TamanhoPaginaPadrao).ToList();

            <div class="table-shell" style="border: 0; box-shadow: none;">
                <table>
                    <thead>
                        <tr>
                            <th style="cursor: pointer;" @onclick='() => OrdenarTopPapeisPor("Codigo")'>
                                Código @IndicadorOrdenacaoTopPapeis("Codigo")
                            </th>
                            <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarTopPapeisPor("ValorTotalAtual")'>
                                Valor total atual @IndicadorOrdenacaoTopPapeis("ValorTotalAtual")
                            </th>
                            <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarTopPapeisPor("DividendosTotal")'>
                                Dividendos total @IndicadorOrdenacaoTopPapeis("DividendosTotal")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in itensTopPagina)
                        {
                            <tr>
                                <td>
                                    <a class="paper-link" href="/papeis/@item.PapelId">@item.Codigo</a>
                                </td>
                                <td class="alinhar-direita font-bold">@FormatarMoeda(item.ValorTotalAtual)</td>
                                <td class="alinhar-direita positive font-bold">@FormatarMoeda(item.DividendosTotal)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="alinhar-esquerda font-bold">Total Top 10</td>
                            <td class="alinhar-direita font-bold">@FormatarMoeda(topOrdenados.Sum(p => p.ValorTotalAtual))</td>
                            <td class="alinhar-direita positive font-bold">@FormatarMoeda(topOrdenados.Sum(p => p.DividendosTotal))</td>
                        </tr>
                    </tfoot>
                </table>
                <div class="table-footer">
                    <span>Mostrando @inicioTop–@fimTop de @totalTop papéis</span>
                    <PaginacaoGrid PaginaAtual="_paginaTopPapeis" TotalPaginas="totalPaginasTop" OnPaginaMudou="p => _paginaTopPapeis = p" />
                </div>
            </div>
        }
    </section>

    <!-- Quick actions -->
    <div class="quick-actions">
        <span>Atalhos rápidos</span>
        <a href="configuracoes"><Icon Name="upload" Size="16" />Importar extrato B3</a>
        <a href="inventario"><Icon Name="inventory" Size="16" />Lançar inventário do mês</a>
        <a href="transacoes"><Icon Name="plus" Size="16" />Nova transação</a>
    </div>
}

@code {
    private const int TamanhoPaginaPadrao = 10;

    private DashboardResponse? _dashboard;
    private IReadOnlyList<TopPapelDashboard> _topPapeis = [];
    private string? _mensagemErro;
    private bool _carregando;
    private bool _modoCapitalAcumulado = true;

    private string _colunaDivTipo = "MesAno";
    private bool _ascDivTipo = false;
    private int _paginaDivTipo = 1;

    private string _colunaTopPapeis = "ValorTotalAtual";
    private bool _ascTopPapeis = false;
    private int _paginaTopPapeis = 1;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _mensagemErro = null;
        try
        {
            _dashboard = await ApiClient.ObterDashboardAsync();
            if (_dashboard.TopPapeis is { Count: > 0 } topDoDashboard)
            {
                _topPapeis = topDoDashboard;
            }
            else
            {
                try
                {
                    var papeisGeral = await ApiClient.ObterPapeisGeralAsync(somenteAtivos: true);
                    _topPapeis = papeisGeral.Itens
                        .Where(p => p.QuantidadeTotal > 0)
                        .OrderByDescending(p => p.TotalAtual)
                        .ThenBy(p => p.Codigo)
                        .Take(10)
                        .Select(p => new TopPapelDashboard(p.Id, p.Codigo, p.TotalAtual, p.TotalDividendos))
                        .ToList();
                }
                catch
                {
                    _topPapeis = [];
                }
            }
        }
        catch (ApiException ex) when (ex.EhNaoAutorizado)
        {
            Navegacao.NavigateTo("/login", forceLoad: false);
        }
        catch (ApiException ex)
        {
            _mensagemErro = ex.Message;
        }
        catch (HttpRequestException)
        {
            _mensagemErro = $"Não foi possível conectar ao servidor da API ({ApiClient.UrlApi}). Verifique se o back-end está em execução.";
        }
        catch (Exception ex)
        {
            _mensagemErro = "Erro ao carregar o dashboard: " + ex.Message;
        }
        finally
        {
            _carregando = false;
        }
    }

    private void OrdenarDivTipoPor(string coluna)
    {
        if (_colunaDivTipo == coluna)
        {
            _ascDivTipo = !_ascDivTipo;
        }
        else
        {
            _colunaDivTipo = coluna;
            _ascDivTipo = true;
        }
        _paginaDivTipo = 1;
    }

    private string IndicadorOrdenacaoDivTipo(string coluna)
    {
        if (_colunaDivTipo != coluna) return "↕";
        return _ascDivTipo ? "↑" : "↓";
    }

    private IEnumerable<DividendoMensalPorTipo> ObterDividendosPorTipoOrdenados()
    {
        if (_dashboard is null) return [];
        var itens = _dashboard.DividendosPorMesETipo.AsEnumerable();

        return _colunaDivTipo switch
        {
            "MesAno" => _ascDivTipo
                ? itens.OrderBy(d => d.Ano).ThenBy(d => d.Mes)
                : itens.OrderByDescending(d => d.Ano).ThenByDescending(d => d.Mes),
            "Acoes" => _ascDivTipo ? itens.OrderBy(d => d.Acoes) : itens.OrderByDescending(d => d.Acoes),
            "Fiis" => _ascDivTipo ? itens.OrderBy(d => d.Fiis) : itens.OrderByDescending(d => d.Fiis),
            "Bdrs" => _ascDivTipo ? itens.OrderBy(d => d.Bdrs) : itens.OrderByDescending(d => d.Bdrs),
            "Etfs" => _ascDivTipo ? itens.OrderBy(d => d.Etfs) : itens.OrderByDescending(d => d.Etfs),
            "Total" => _ascDivTipo ? itens.OrderBy(d => d.Total) : itens.OrderByDescending(d => d.Total),
            _ => itens.OrderByDescending(d => d.Ano).ThenByDescending(d => d.Mes)
        };
    }

