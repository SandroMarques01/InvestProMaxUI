@page "/"
@inject IInvestProMaxApiClient ApiClient
@inject NavigationManager Navegacao

<header class="page-header">
    <div>
        <div class="breadcrumb">InvestProMax <Icon Name="chevron" Size="12" /> Dashboard</div>
        <h1>Dashboard</h1>
    </div>
    @if (_dashboard is not null)
    {
        <div class="page-actions">
            @if (!_editandoLayout)
            {
                <button type="button" class="btn btn-secondary" @onclick="IniciarEdicaoLayout">
                    <Icon Name="settings" Size="16" /><span>Personalizar layout</span>
                </button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" @onclick="RestaurarLayoutPadrao" disabled="@_salvandoLayout">
                    <Icon Name="refresh" Size="16" /><span>Restaurar padrão</span>
                </button>
                <button type="button" class="btn btn-secondary" @onclick="CancelarEdicaoLayout" disabled="@_salvandoLayout">
                    <Icon Name="close" Size="16" /><span>Cancelar</span>
                </button>
                <button type="button" class="btn btn-primary" @onclick="SalvarLayoutAsync" disabled="@_salvandoLayout">
                    <Icon Name="check" Size="16" /><span>@(_salvandoLayout ? "Salvando..." : "Salvar layout")</span>
                </button>
            }
        </div>
    }
</header>

@if (_mensagemErro is not null && _dashboard is null)
{
    <div class="card state-card">
        <img src="_content/InvestProMax.SharedUI/images/moedas-caindo.gif" alt="Carregando..." class="loading-gif" />
        <h2>Não foi possível carregar o Dashboard</h2>
        <p style="max-width: 520px; margin: 8px auto 18px; color: var(--muted); font-size: 12px; line-height: 1.5;">@_mensagemErro</p>
        <button type="button" class="btn btn-primary" @onclick="CarregarAsync" disabled="@_carregando">
            <Icon Name="refresh" Size="16" /><span>@(_carregando ? "Tentando..." : "Tentar novamente")</span>
        </button>
    </div>
}
else if (_dashboard is null)
{
    <LoadingState Mensagem="Carregando dados do dashboard..." Subtitulo="Aguarde enquanto calculamos os indicadores da sua carteira." />
}
else
{
    @if (_mensagemErro is not null)
    {
        <div class="alerta-erro">@_mensagemErro</div>
    }
    @if (_mensagemSucesso is not null)
    {
        <div class="alerta-sucesso">@_mensagemSucesso</div>
    }
    @if (_editandoLayout)
    {
        <div class="dashboard-edit-banner">
            <span>
                <strong>Modo de personalização ativo:</strong> arraste para reordenar, ajuste <strong>Largura</strong> (20%, 25%, 33%, 40%, 50%, 60%, 67%, 75%, 80%, 100%) e <strong>Altura</strong>, ou retire/reinsira itens usando a barra inferior de itens ocultos. Clique em <strong>Salvar layout</strong> para gravar no MongoDB.
            </span>
        </div>
    }

    var rendimentoCarteira = _dashboard.TotalInvestidoCarteira > 0
        ? (_dashboard.GanhoTotalCarteira / _dashboard.TotalInvestidoCarteira)
        : 0m;
    var ehPositivo = _dashboard.GanhoTotalCarteira >= 0;

    var hoje = DateOnly.FromDateTime(DateTime.UtcNow);
    var mesAnterior = new DateOnly(hoje.Year, hoje.Month, 1).AddMonths(-1);
    var evolucaoAteMesAnterior = _dashboard.EvolucaoCapital
        .Where(e => e.Ano < mesAnterior.Year || (e.Ano == mesAnterior.Year && e.Mes <= mesAnterior.Month))
        .OrderBy(e => e.Ano)
        .ThenBy(e => e.Mes)
        .LastOrDefault();
    var totalInvestidoAteMesAnterior = evolucaoAteMesAnterior?.CapitalAcumulado ?? 0m;
    var pctDividendoMesSobreInvestidoAnterior = totalInvestidoAteMesAnterior > 0m
        ? (_dashboard.DividendosNoMes / totalInvestidoAteMesAnterior) * 100m
        : 0m;

    @if (_ordemKpis.Count > 0 || _editandoLayout)
    {
        <div class="dashboard-kpis-grid">
            @if (_ordemKpis.Count == 0 && _editandoLayout)
            {
                <div class="dashboard-empty-dropzone @(_sobreAreaKpisVazia ? "drag-over" : "")"
                     @ondragover:preventDefault="true"
                     @ondragenter="() => _sobreAreaKpisVazia = true"
                     @ondragleave="() => _sobreAreaKpisVazia = false"
                     @ondrop="SoltarEmAreaKpisVazia">
                    Todos os KPIs estão ocultos. Arraste um KPI da barra inferior para cá ou clique em <strong>+ Exibir no Dash</strong>.
                </div>
            }
            @foreach (var kpiId in _ordemKpis)
            {
                var id = kpiId;
                <section @key="id"
                         class="@ObterClasseKpi(id)"
                         draggable="@(_editandoLayout ? "true" : "false")"
                         @ondragstart="() => IniciarArrasteKpi(id)"
                         @ondragover:preventDefault="true"
                         @ondragenter="() => AoEntrarAlvoKpi(id)"
                         @ondrop="() => SoltarKpi(id)"
                         @ondragend="FinalizarArraste">
                    @if (_editandoLayout)
                    {
                        <div class="dashboard-item-toolbar" @onclick:stopPropagation="true">
                            <span class="drag-handle" title="Arraste para reordenar ou mover para a barra inferior">⠿ Arrastar</span>
                            <div class="dashboard-item-controls">
                                <div class="dash-ctrl-group" title="Largura na grade de 12 colunas">
                                    <button type="button" class="dash-ctrl-btn" @onclick="() => AlterarLargura(id, -1)" disabled="@(!PodeDiminuirLargura(id))">−</button>
                                    <select class="dash-ctrl-select" value="@ObterColunas(id)" @onchange="e => DefinirLargura(id, e.Value)">
                                        @foreach (var op in OpcoesLargura)
                                        {
                                            <option value="@op.Colunas">@op.Rotulo</option>
                                        }
                                    </select>
                                    <button type="button" class="dash-ctrl-btn" @onclick="() => AlterarLargura(id, 1)" disabled="@(!PodeAumentarLargura(id))">+</button>
                                </div>
                                <div class="dash-ctrl-group" title="Altura do card">
                                    <span class="dash-ctrl-label">Alt</span>
                                    <select class="dash-ctrl-select" value="@ObterAltura(id)" @onchange="e => DefinirAltura(id, e.Value)">
                                        @foreach (var alt in OpcoesAltura)
                                        {
                                            <option value="@alt.Codigo">@alt.Rotulo</option>
                                        }
                                    </select>
                                </div>
                                <button type="button" class="dash-ctrl-remove" title="Retirar do Dashboard" @onclick="() => OcultarKpi(id)">✕</button>
                            </div>
                        </div>
                    }
                    @switch (id)
                    {
                        case "patrimonio-total":
                            <div class="kpi-top">
                                <span>Patrimônio total (Mês atual)</span>
                                <div class="kpi-icon"><Icon Name="assets" Size="16" /></div>
                            </div>
                            <strong>@FormatarMoeda(_dashboard.PatrimonioTotal)</strong>
                            <div class="kpi-meta">
                                <span>@(_dashboard.PatrimonioMes is not null ? $"Competência: {_dashboard.PatrimonioMes:00}/{_dashboard.PatrimonioAno}" : "Posição consolidada da carteira")</span>
                            </div>
                            break;

                        case "total-atual":
                            <div class="kpi-top">
                                <span>Total atual (Carteira)</span>
                                <div class="kpi-icon"><Icon Name="papers" Size="16" /></div>
                            </div>
                            <strong>@FormatarMoeda(_dashboard.TotalAtualCarteira)</strong>
                            <div class="kpi-meta">
                                <span>Valor a mercado das posições</span>
                            </div>
                            break;

                        case "total-investido":
                            <div class="kpi-top">
                                <span>Total investido (Carteira)</span>
                                <div class="kpi-icon"><Icon Name="transaction" Size="16" /></div>
                            </div>
                            <strong>@FormatarMoeda(_dashboard.TotalInvestidoCarteira)</strong>
                            <div class="kpi-meta">
                                <span>Custo das posições em aberto</span>
                            </div>
                            break;

                        case "ganho-perda":
                            <div class="kpi-top">
                                <span>Ganho / Perda da carteira</span>
                                <div class="kpi-icon @(ehPositivo ? "positive" : "negative")">
                                    <Icon Name="papers" Size="16" />
                                </div>
                            </div>
                            <strong class="@(ehPositivo ? "positive" : "negative")">@FormatarMoeda(_dashboard.GanhoTotalCarteira)</strong>
                            <div class="kpi-meta @(ehPositivo ? "positive" : "negative")">
                                <span>@(ehPositivo ? "+" : "")@rendimentoCarteira.ToString("P2") sobre o custo</span>
                            </div>
                            break;

                        case "dividendos-mes":
                            <div class="kpi-top">
                                <span>Dividendos no mês</span>
                                <div class="kpi-icon positive"><Icon Name="dividend" Size="16" /></div>
                            </div>
                            <strong class="positive">@FormatarMoeda(_dashboard.DividendosNoMes)</strong>
                            <div class="kpi-meta" style="display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
                                <span class="positive" title="Percentual do dividendo do mês pelo valor total investido até o mês anterior (@FormatarMoeda(totalInvestidoAteMesAnterior))">
                                    @pctDividendoMesSobreInvestidoAnterior.ToString("N2")% sobre investido até mês ant.
                                </span>
                                <span>Total histórico: @FormatarMoeda(_dashboard.TotalDividendosHistorico)</span>
                            </div>
                            break;
                    }
                </section>
            }
        </div>
    }

    @if (_ordemCards.Count > 0 || _editandoLayout)
    {
        <div class="dashboard-cards-grid">
            @if (_ordemCards.Count == 0 && _editandoLayout)
            {
                <div class="dashboard-empty-dropzone @(_sobreAreaCardsVazia ? "drag-over" : "")"
                     @ondragover:preventDefault="true"
                     @ondragenter="() => _sobreAreaCardsVazia = true"
                     @ondragleave="() => _sobreAreaCardsVazia = false"
                     @ondrop="SoltarEmAreaCardsVazia">
                    Todos os gráficos e grids estão ocultos. Arraste um gráfico ou grid da barra inferior para cá ou clique em <strong>+ Exibir no Dash</strong>.
                </div>
            }
            @foreach (var cardId in _ordemCards)
            {
                var id = cardId;
                <section @key="id"
                         class="@ObterClasseCard(id)"
                         draggable="@(_editandoLayout ? "true" : "false")"
                         @ondragstart="() => IniciarArrasteCard(id)"
                         @ondragover:preventDefault="true"
                         @ondragenter="() => AoEntrarAlvoCard(id)"
                         @ondrop="() => SoltarCard(id)"
                         @ondragend="FinalizarArraste">
                    @if (_editandoLayout)
                    {
                        <div class="dashboard-item-toolbar" @onclick:stopPropagation="true">
                            <span class="drag-handle" title="Arraste para reordenar ou mover para a barra inferior">⠿ Arrastar</span>
                            <div class="dashboard-item-controls">
                                <div class="dash-ctrl-group" title="Largura na grade de 12 colunas">
                                    <span class="dash-ctrl-label">Larg</span>
                                    <button type="button" class="dash-ctrl-btn" @onclick="() => AlterarLargura(id, -1)" disabled="@(!PodeDiminuirLargura(id))">−</button>
                                    <select class="dash-ctrl-select" value="@ObterColunas(id)" @onchange="e => DefinirLargura(id, e.Value)">
                                        @foreach (var op in OpcoesLargura)
                                        {
                                            <option value="@op.Colunas">@op.Rotulo</option>
                                        }
                                    </select>
                                    <button type="button" class="dash-ctrl-btn" @onclick="() => AlterarLargura(id, 1)" disabled="@(!PodeAumentarLargura(id))">+</button>
                                </div>
                                <div class="dash-ctrl-group" title="Altura do card">
                                    <span class="dash-ctrl-label">Altura</span>
                                    <select class="dash-ctrl-select" value="@ObterAltura(id)" @onchange="e => DefinirAltura(id, e.Value)">
                                        @foreach (var alt in OpcoesAltura)
                                        {
                                            <option value="@alt.Codigo">@alt.Rotulo</option>
                                        }
                                    </select>
                                </div>
                                <button type="button" class="dash-ctrl-remove" title="Retirar do Dashboard" @onclick="() => OcultarCard(id)">✕ Ocultar</button>
                            </div>
                        </div>
                    }
                    @switch (id)
                    {
                        case "alocacao-tipo":
                            <div class="section-title">
                                <div>
                                    <h2>Alocação por tipo</h2>
                                    <p>Distribuição do patrimônio em carteira (Pizza)</p>
                                </div>
                                @if (_dashboard.AlocacaoPorTipoPapel.Count > 0)
                                {
                                    <div style="font-size: 11px;">
                                        <span style="color: var(--muted);">Total: </span>
                                        <strong>@FormatarMoeda(_dashboard.AlocacaoPorTipoPapel.Sum(a => a.Valor))</strong>
                                    </div>
                                }
                            </div>

                            @if (_dashboard.AlocacaoPorTipoPapel.Count == 0)
                            {
                                <div style="padding: 30px; text-align: center; color: var(--muted);">
                                    Nenhuma posição ativa em carteira.
                                </div>
                            }
                            else
                            {
                                var totalAlocado = _dashboard.AlocacaoPorTipoPapel.Sum(a => a.Valor);
                                var fatias = CalcularFatiasPizza(_dashboard.AlocacaoPorTipoPapel, totalAlocado);

                                <div class="pizza-chart-wrap">
                                    <svg viewBox="0 0 200 200" class="pizza-svg" aria-label="Gráfico de pizza da alocação da carteira">
                                        @foreach (var fatia in fatias)
                                        {
                                            <path d="@fatia.SvgPath"
                                                  fill="@fatia.Cor"
                                                  stroke="var(--surface)"
                                                  stroke-width="1.5"
                                                  stroke-linejoin="round"
                                                  class="pizza-slice">
                                                <title>@($"{ObterNomeTipoPapel(fatia.Tipo)}: {FormatarMoeda(fatia.Valor)} ({fatia.Percentual:P1})")</title>
                                            </path>
                                        }
                                    </svg>
                                    <div class="chart-legend">
                                        @foreach (var item in _dashboard.AlocacaoPorTipoPapel)
                                        {
                                            var pct = totalAlocado > 0 ? (item.Valor / totalAlocado).ToString("P1") : "0%";
                                            <div>
                                                <span class="dot" style="background: @ObterCorTipoPapel(item.TipoPapel);"></span>
                                                <span>@ObterNomeTipoPapel(item.TipoPapel)</span>
                                                <strong>@pct</strong>
                                                <span class="legend-val">@FormatarMoeda(item.Valor)</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            break;

                        case "dividendos-recebidos":
                            <div class="section-title">
                                <div>
                                    <h2>Dividendos recebidos</h2>
                                    <p>Histórico dos últimos 12 meses (Coluna por mês)</p>
                                </div>
                                @if (_dashboard.DividendosPorMes.Count > 0)
                                {
                                    var total12M = _dashboard.DividendosPorMes.Sum(d => d.Total);
                                    var media12M = total12M / 12m;
                                    <div style="text-align: right; font-size: 11px;">
                                        <span style="color: var(--muted);">Total 12M: </span><strong class="positive">@FormatarMoeda(total12M)</strong>
                                        <span style="color: var(--muted); margin-left: 8px;">Média: </span><strong>@FormatarMoeda(media12M)/mês</strong>
                                    </div>
                                }
                            </div>

                            var maxDiv = _dashboard.DividendosPorMes.Count > 0 ? _dashboard.DividendosPorMes.Max(d => d.Total) : 0;
                            if (maxDiv <= 0) maxDiv = 1;

                            <div class="chart-with-grid">
                                <div class="chart-y-axis">
                                    <div class="grid-line"><span>@FormatarMoedaAbrev(maxDiv)</span></div>
                                    <div class="grid-line"><span>@FormatarMoedaAbrev(maxDiv / 2)</span></div>
                                    <div class="grid-line"><span>R$ 0</span></div>
                                </div>
                                <div class="bars-stage">
                                    @foreach (var mes in _dashboard.DividendosPorMes)
                                    {
                                        var ehMesAtual = mes.Ano == hoje.Year && mes.Mes == hoje.Month;
                                        var altura = (double)(mes.Total / maxDiv) * 100;
                                        var tooltip = $"{mes.Mes:00}/{mes.Ano}: {FormatarMoeda(mes.Total)}";

                                        <div class="bar-col @(ehMesAtual ? "is-current" : "")" title="@tooltip">
                                            <div class="stack-wrap">
                                                @if (mes.Total > 0)
                                                {
                                                    <div class="stack @(ehMesAtual ? "is-current" : "")"
                                                         style="height: @FormatarAlturaCss(altura); background: linear-gradient(180deg, var(--primary-mid) 0%, var(--primary) 100%);">
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div style="width: 14px; height: 3px; background: var(--line); border-radius: 2px;"></div>
                                                }
                                            </div>
                                            <span>@($"{mes.Mes:00}/{mes.Ano.ToString()[2..]}")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            break;

                        case "aumento-capital":
                            <div class="section-title">
                                <div>
                                    <h2>Aumento de capital investido</h2>
                                    <p>Evolução nos últimos 12 meses (Coluna)</p>
                                </div>
                                <div class="chart-toggle">
                                    <button type="button" class="@(_modoCapitalAcumulado ? "active" : "")" @onclick="() => _modoCapitalAcumulado = true">
                                        Capital Acumulado
                                    </button>
                                    <button type="button" class="@(!_modoCapitalAcumulado ? "active" : "")" @onclick="() => _modoCapitalAcumulado = false">
                                        Aportes no Mês
                                    </button>
                                </div>
                            </div>

                        var serie12Meses = ObterSerieEvolucao12Meses(_dashboard.DividendosPorMes, _dashboard.EvolucaoCapital);
                        var maxCap = _modoCapitalAcumulado
                            ? (serie12Meses.Count > 0 ? serie12Meses.Max(s => s.CapitalAcumulado) : 0m)
                            : (serie12Meses.Count > 0 ? serie12Meses.Max(s => Math.Max(0m, s.AporteLiquido)) : 0m);
                        if (maxCap <= 0) maxCap = 1;

                        <div class="chart-with-grid">
                            <div class="chart-y-axis">
                                <div class="grid-line"><span>@FormatarMoedaAbrev(maxCap)</span></div>
                                <div class="grid-line"><span>@FormatarMoedaAbrev(maxCap / 2)</span></div>
                                <div class="grid-line"><span>R$ 0</span></div>
                            </div>
                            <div class="bars-stage">
                                @foreach (var item in serie12Meses)
                                {
                                    var ehMesAtual = item.Ano == hoje.Year && item.Mes == hoje.Month;
                                    var valorExibido = _modoCapitalAcumulado ? item.CapitalAcumulado : item.AporteLiquido;
                                    var altura = (double)(Math.Max(0, valorExibido) / maxCap) * 100;
                                    var tooltip = $"{item.Mes:00}/{item.Ano}\nCapital Acumulado: {FormatarMoeda(item.CapitalAcumulado)}\nAporte Líquido: {FormatarMoeda(item.AporteLiquido)}\nCompras: {FormatarMoeda(item.Compras)}\nVendas: {FormatarMoeda(item.Vendas)}";

                                    <div class="bar-col @(ehMesAtual ? "is-current" : "")" title="@tooltip">
                                        <div class="stack-wrap">
                                            @if (valorExibido > 0)
                                            {
                                                <div class="stack @(ehMesAtual ? "is-current" : "")"
                                                     style="height: @FormatarAlturaCss(altura); background: linear-gradient(180deg, #3fa360 0%, #1e6b3c 100%);">
                                                </div>
                                            }
                                            else if (valorExibido < 0)
                                            {
                                                <div style="width: 14px; height: 6px; background: var(--danger); border-radius: 2px;"></div>
                                            }
                                            else
                                            {
                                                <div style="width: 14px; height: 3px; background: var(--line); border-radius: 2px;"></div>
                                            }
                                        </div>
                                        <span>@($"{item.Mes:00}/{item.Ano.ToString()[2..]}")</span>
                                    </div>
                                }
                            </div>
                        </div>
                        break;

                        case "dividendos-por-tipo":
                            <div class="section-title">
                                <div>
                                    <h2>Dividendos por tipo</h2>
                                    <p>Demonstrativo completo somado por tipo por mês</p>
                                </div>
                                @if (_dashboard.DividendosPorMesETipo.Count > 0)
                                {
                                    var totalGeral = _dashboard.DividendosPorMesETipo.Sum(d => d.Total);
                                    <div style="font-size: 11px;">
                                        <span style="color: var(--muted);">Total histórico: </span>
                                        <strong class="positive">@FormatarMoeda(totalGeral)</strong>
                                    </div>
                                }
                            </div>

                            @if (_dashboard.DividendosPorMesETipo.Count == 0)
                            {
                                <div style="padding: 30px; text-align: center; color: var(--muted);">
                                    Nenhum provento registrado.
                                </div>
                            }
                            else
                            {
                                var listaOrdenada = ObterDividendosPorTipoOrdenados().ToList();
                                var totalRegistrosDiv = listaOrdenada.Count;
                                var totalPaginasDiv = Math.Max(1, (int)Math.Ceiling((double)totalRegistrosDiv / _tamanhoPaginaDivTipo));
                                if (_paginaDivTipo > totalPaginasDiv) _paginaDivTipo = totalPaginasDiv;

                                var inicioDiv = ((_paginaDivTipo - 1) * _tamanhoPaginaDivTipo) + 1;
                                var fimDiv = Math.Min(_paginaDivTipo * _tamanhoPaginaDivTipo, totalRegistrosDiv);
                                var itensPaginaDiv = listaOrdenada.Skip((_paginaDivTipo - 1) * _tamanhoPaginaDivTipo).Take(_tamanhoPaginaDivTipo).ToList();

                                var totalAcoes = listaOrdenada.Sum(d => d.Acoes);
                                var totalFiis = listaOrdenada.Sum(d => d.Fiis);
                                var totalBdrs = listaOrdenada.Sum(d => d.Bdrs);
                                var totalEtfs = listaOrdenada.Sum(d => d.Etfs);
                                var totalTudo = listaOrdenada.Sum(d => d.Total);

                                <div class="table-shell" style="border: 0; box-shadow: none;">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th class="alinhar-centro" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("MesAno")'>
                                                    Mês/Ano @IndicadorOrdenacaoDivTipo("MesAno")
                                                </th>
                                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Acoes")'>
                                                    Ações @IndicadorOrdenacaoDivTipo("Acoes")
                                                </th>
                                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Fiis")'>
                                                    FIIs @IndicadorOrdenacaoDivTipo("Fiis")
                                                </th>
                                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Bdrs")'>
                                                    BDRs @IndicadorOrdenacaoDivTipo("Bdrs")
                                                </th>
                                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Etfs")'>
                                                    ETFs @IndicadorOrdenacaoDivTipo("Etfs")
                                                </th>
                                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarDivTipoPor("Total")'>
                                                    Total @IndicadorOrdenacaoDivTipo("Total")
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in itensPaginaDiv)
                                            {
                                                <tr>
                                                    <td class="alinhar-centro font-bold">@($"{item.Mes:00}/{item.Ano}")</td>
                                                    <td class="alinhar-direita">@(item.Acoes > 0 ? FormatarMoeda(item.Acoes) : "–")</td>
                                                    <td class="alinhar-direita">@(item.Fiis > 0 ? FormatarMoeda(item.Fiis) : "–")</td>
                                                    <td class="alinhar-direita">@(item.Bdrs > 0 ? FormatarMoeda(item.Bdrs) : "–")</td>
                                                    <td class="alinhar-direita">@(item.Etfs > 0 ? FormatarMoeda(item.Etfs) : "–")</td>
                                                    <td class="alinhar-direita positive font-bold">@FormatarMoeda(item.Total)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td class="alinhar-centro font-bold">Total Geral</td>
                                                <td class="alinhar-direita">@FormatarMoeda(totalAcoes)</td>
                                                <td class="alinhar-direita">@FormatarMoeda(totalFiis)</td>
                                                <td class="alinhar-direita">@FormatarMoeda(totalBdrs)</td>
                                                <td class="alinhar-direita">@FormatarMoeda(totalEtfs)</td>
                                                <td class="alinhar-direita positive font-bold">@FormatarMoeda(totalTudo)</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                    <div class="table-footer">
                                        <span>Mostrando @inicioDiv–@fimDiv de @totalRegistrosDiv competências</span>
                                        <PaginacaoGrid PaginaAtual="_paginaDivTipo" TotalPaginas="totalPaginasDiv" @bind-TamanhoPagina="_tamanhoPaginaDivTipo" OnPaginaMudou="p => _paginaDivTipo = p" />
                                    </div>
                                </div>
                            }
                            break;

                        case "top10-papeis":
                            <div class="section-title">
                                <div>
                                    <h2>Top 10 papéis com maior total atual</h2>
                                    <p>Maiores posições ativas da carteira por valor total de mercado</p>
                                </div>
                                @if (_topPapeis.Count > 0)
                                {
                                    <div style="font-size: 11px;">
                                        <span style="color: var(--muted);">Total Top 10: </span>
                                        <strong class="positive">@FormatarMoeda(_topPapeis.Sum(p => p.ValorTotalAtual))</strong>
                                    </div>
                                }
                            </div>

                            @if (_topPapeis.Count == 0)
                            {
                                <div style="padding: 30px; text-align: center; color: var(--muted);">
                                    Nenhum papel ativo em carteira.
                                </div>
                            }
                            else
                            {
                                var topOrdenados = ObterTopPapeisOrdenados().ToList();
                                var totalTop = topOrdenados.Count;
                                var totalPaginasTop = Math.Max(1, (int)Math.Ceiling((double)totalTop / _tamanhoPaginaTopPapeis));
                                if (_paginaTopPapeis > totalPaginasTop) _paginaTopPapeis = totalPaginasTop;

                                var inicioTop = ((_paginaTopPapeis - 1) * _tamanhoPaginaTopPapeis) + 1;
                                var fimTop = Math.Min(_paginaTopPapeis * _tamanhoPaginaTopPapeis, totalTop);
                                var itensTopPagina = topOrdenados.Skip((_paginaTopPapeis - 1) * _tamanhoPaginaTopPapeis).Take(_tamanhoPaginaTopPapeis).ToList();

                                <div class="table-shell" style="border: 0; box-shadow: none;">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th class="alinhar-centro" style="cursor: pointer;" @onclick='() => OrdenarTopPapeisPor("Codigo")'>
                                                    Código @IndicadorOrdenacaoTopPapeis("Codigo")
                                                </th>
                                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarTopPapeisPor("ValorTotalAtual")'>
                                                    Valor total atual @IndicadorOrdenacaoTopPapeis("ValorTotalAtual")
                                                </th>
                                                <th class="alinhar-direita" style="cursor: pointer;" @onclick='() => OrdenarTopPapeisPor("DividendosTotal")'>
                                                    Dividendos total @IndicadorOrdenacaoTopPapeis("DividendosTotal")
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in itensTopPagina)
                                            {
                                                <tr>
                                                    <td class="alinhar-centro font-bold">
                                                        <a class="paper-link" href="/papeis/@item.PapelId">@item.Codigo</a>
                                                    </td>
                                                    <td class="alinhar-direita">@FormatarMoeda(item.ValorTotalAtual)</td>
                                                    <td class="alinhar-direita positive font-bold">@FormatarMoeda(item.DividendosTotal)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td class="alinhar-centro font-bold">Total Geral</td>
                                                <td class="alinhar-direita">@FormatarMoeda(topOrdenados.Sum(p => p.ValorTotalAtual))</td>
                                                <td class="alinhar-direita positive font-bold">@FormatarMoeda(topOrdenados.Sum(p => p.DividendosTotal))</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                    <div class="table-footer">
                                        <span>Mostrando @inicioTop–@fimTop de @totalTop papéis</span>
                                        <PaginacaoGrid PaginaAtual="_paginaTopPapeis" TotalPaginas="totalPaginasTop" @bind-TamanhoPagina="_tamanhoPaginaTopPapeis" OnPaginaMudou="p => _paginaTopPapeis = p" />
                                    </div>
                                </div>
                            }
                            break;
                    }
                </section>
            }
        </div>
    }

    @if (_editandoLayout)
    {
        var itensOcultos = ObterItensOcultos();
        <section class="dashboard-hidden-tray @(_sobreBandejaOcultos ? "drag-over" : "")"
                 @ondragover:preventDefault="true"
                 @ondragenter="AoEntrarBandejaOcultos"
                 @ondragleave="() => _sobreBandejaOcultos = false"
                 @ondrop="SoltarNaBandejaOcultos">
            <div class="dashboard-hidden-tray-header">
                <div>
                    <h3>KPIs, Gráficos e Grids fora do Dashboard (@itensOcultos.Count)</h3>
                    <p>Arraste um card do Dashboard para cá (ou clique em ✕) para ocultá-lo. Para reinserir, arraste de volta ou clique em <strong>+ Exibir no Dash</strong>.</p>
                </div>
            </div>

            @if (itensOcultos.Count == 0)
            {
                <div style="padding: 14px; text-align: center; color: var(--muted); font-size: 12px;">
                    Todos os KPIs, gráficos e grids estão visíveis no Dashboard. Arraste qualquer bloco para esta barra para retirá-lo da visão.
                </div>
            }
            else
            {
                <div class="dashboard-hidden-list">
                    @foreach (var oculto in itensOcultos)
                    {
                        var item = oculto;
                        <div @key="item.Id"
                             class="dashboard-hidden-item"
                             draggable="true"
                             @ondragstart="() => IniciarArrasteItemOculto(item.Id, item.EhKpi)"
                             @ondragend="FinalizarArraste">
                            <div class="dashboard-hidden-item-info">
                                <span class="dashboard-hidden-item-badge">@item.Categoria</span>
                                <span class="dashboard-hidden-item-title">@item.Titulo</span>
                                <span class="dashboard-hidden-item-desc">@item.Descricao</span>
                            </div>
                            <button type="button"
                                    class="dash-btn-restore-item"
                                    @onclick="() => RestaurarItemOculto(item.Id, item.EhKpi)">
                                + Exibir no Dash
                            </button>
                        </div>
                    }
                </div>
            }
        </section>
    }

    <!-- Quick actions -->
    <div class="quick-actions">
        <span>Atalhos rápidos</span>
        <a href="configuracoes"><Icon Name="upload" Size="16" />Importar extrato B3</a>
        <a href="inventario"><Icon Name="inventory" Size="16" />Lançar inventário do mês</a>
        <a href="transacoes"><Icon Name="plus" Size="16" />Nova transação</a>
    </div>
}

@code {
    private const int TamanhoPaginaPadrao = 10;

    private static readonly string[] KpisPadrao =
        ["patrimonio-total", "total-atual", "total-investido", "ganho-perda", "dividendos-mes"];

    private static readonly string[] CardsPadrao =
        ["alocacao-tipo", "dividendos-recebidos", "aumento-capital", "dividendos-por-tipo", "top10-papeis"];

    private static readonly (int Colunas, string Rotulo)[] OpcoesLargura =
    [
        (2, "1/5 (20%)"),
        (3, "1/4 (25%)"),
        (4, "1/3 (33%)"),
        (5, "2/5 (40%)"),
        (6, "1/2 (50%)"),
        (7, "3/5 (60%)"),
        (8, "2/3 (67%)"),
        (9, "3/4 (75%)"),
        (10, "4/5 (80%)"),
        (12, "100%")
    ];

    private static readonly (string Codigo, string Rotulo)[] OpcoesAltura =
    [
        ("auto", "Auto"),
        ("sm", "Compacta"),
        ("md", "Média"),
        ("lg", "Grande"),
        ("xl", "Extra")
    ];

    private sealed record MetadadosBlocoDashboard(string Id, string Categoria, string Titulo, string Descricao, bool EhKpi);

    private static readonly IReadOnlyList<MetadadosBlocoDashboard> CatalogoBlocos =
    [
        new("patrimonio-total", "KPI", "Patrimônio total (Mês atual)", "Posição consolidada da carteira", true),
        new("total-atual", "KPI", "Total atual (Carteira)", "Valor a mercado das posições", true),
        new("total-investido", "KPI", "Total investido (Carteira)", "Custo das posições em aberto", true),
        new("ganho-perda", "KPI", "Ganho / Perda da carteira", "Resultado financeiro e % sobre o custo", true),
        new("dividendos-mes", "KPI", "Dividendos no mês", "Proventos do mês e total histórico", true),
        new("alocacao-tipo", "Gráfico", "Alocação por tipo", "Distribuição do patrimônio em carteira (Pizza)", false),
        new("dividendos-recebidos", "Gráfico", "Dividendos recebidos", "Histórico dos últimos 12 meses (Coluna)", false),
        new("aumento-capital", "Gráfico", "Aumento de capital investido", "Evolução nos últimos 12 meses (Coluna)", false),
        new("dividendos-por-tipo", "Grid", "Dividendos por tipo", "Demonstrativo completo somado por tipo por mês", false),
        new("top10-papeis", "Grid", "Top 10 papéis com maior total atual", "Maiores posições ativas da carteira", false)
    ];

    private DashboardResponse? _dashboard;
    private IReadOnlyList<TopPapelDashboard> _topPapeis = [];
    private string? _mensagemErro;
    private string? _mensagemSucesso;
    private bool _carregando;
    private bool _modoCapitalAcumulado = true;

    private List<string> _ordemKpis = [.. KpisPadrao];
    private List<string> _ordemCards = [.. CardsPadrao];
    private Dictionary<string, DashboardItemDimensaoDto> _dimensoes = CriarDimensoesPadrao();
    private DashboardLayoutDto? _layoutAntesEdicao;
    private bool _editandoLayout;
    private bool _salvandoLayout;
    private string? _kpiArrastando;
    private string? _kpiSobreAlvo;
    private string? _cardArrastando;
    private string? _cardSobreAlvo;
    private bool _sobreBandejaOcultos;
    private bool _sobreAreaKpisVazia;
    private bool _sobreAreaCardsVazia;

    private string _colunaDivTipo = "MesAno";
    private bool _ascDivTipo = false;
    private int _paginaDivTipo = 1;
    private int _tamanhoPaginaDivTipo = 15;
    private bool _tamanhoDivTipoDefinidoPeloUsuario;

    private string _colunaTopPapeis = "ValorTotalAtual";
    private bool _ascTopPapeis = false;
    private int _paginaTopPapeis = 1;
    private int _tamanhoPaginaTopPapeis = 15;
    private bool _tamanhoTopPapeisDefinidoPeloUsuario;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _mensagemErro = null;
        try
        {
            _dashboard = await ApiClient.ObterDashboardAsync();
            await CarregarLayoutSalvoAsync();
            if (!_tamanhoDivTipoDefinidoPeloUsuario)
            {
                _tamanhoPaginaDivTipo = PaginacaoGrid.CalcularTamanhoPadrao(_dashboard.DividendosPorMesETipo.Count);
                _tamanhoDivTipoDefinidoPeloUsuario = true;
            }
            if (_dashboard.TopPapeis is { Count: > 0 } topDoDashboard)
            {
                _topPapeis = topDoDashboard;
            }
            else
            {
                try
                {
                    var papeisGeral = await ApiClient.ObterPapeisGeralAsync(somenteAtivos: true);
                    _topPapeis = papeisGeral.Itens
                        .Where(p => p.QuantidadeTotal > 0)
                        .OrderByDescending(p => p.TotalAtual)
                        .ThenBy(p => p.Codigo)
                        .Take(10)
                        .Select(p => new TopPapelDashboard(p.Id, p.Codigo, p.TotalAtual, p.TotalDividendos))
                        .ToList();
                }
                catch
                {
                    _topPapeis = [];
                }
            }
            if (!_tamanhoTopPapeisDefinidoPeloUsuario)
            {
                _tamanhoPaginaTopPapeis = PaginacaoGrid.CalcularTamanhoPadrao(_topPapeis.Count);
                _tamanhoTopPapeisDefinidoPeloUsuario = true;
            }
        }
        catch (ApiException ex) when (ex.EhNaoAutorizado)
        {
            Navegacao.NavigateTo("/login", forceLoad: false);
        }
        catch (ApiException ex)
        {
            _mensagemErro = ex.Message;
        }
        catch (HttpRequestException)
        {
            _mensagemErro = $"Não foi possível conectar ao servidor da API ({ApiClient.UrlApi}). Verifique se o back-end está em execução.";
        }
        catch (Exception ex)
        {
            _mensagemErro = "Erro ao carregar o dashboard: " + ex.Message;
        }
        finally
        {
            _carregando = false;
        }
    }

    private static Dictionary<string, DashboardItemDimensaoDto> CriarDimensoesPadrao() =>
        new(StringComparer.Ordinal)
        {
            ["patrimonio-total"] = new(2, "auto"),
            ["total-atual"] = new(2, "auto"),
            ["total-investido"] = new(2, "auto"),
            ["ganho-perda"] = new(2, "auto"),
            ["dividendos-mes"] = new(2, "auto"),
            ["alocacao-tipo"] = new(6, "auto"),
            ["dividendos-recebidos"] = new(6, "auto"),
            ["aumento-capital"] = new(6, "auto"),
            ["dividendos-por-tipo"] = new(6, "auto"),
            ["top10-papeis"] = new(12, "auto")
        };

    private async Task CarregarLayoutSalvoAsync()
    {
        try
        {
            var layout = await ApiClient.ObterDashboardLayoutAsync();
            if (EhSubconjuntoValido(layout.Kpis, KpisPadrao))
            {
                _ordemKpis = layout.Kpis.ToList();
            }
            if (EhSubconjuntoValido(layout.Cards, CardsPadrao))
            {
                _ordemCards = layout.Cards.ToList();
            }
            var dimensoes = CriarDimensoesPadrao();
            if (layout.Dimensoes is not null)
            {
                foreach (var (id, dim) in layout.Dimensoes)
                {
                    if (dimensoes.ContainsKey(id) && dim is not null)
                    {
                        var col = OpcoesLargura.Any(o => o.Colunas == dim.Colunas) ? dim.Colunas : dimensoes[id].Colunas;
                        var alt = OpcoesAltura.Any(a => a.Codigo == dim.Altura) ? dim.Altura : "auto";
                        dimensoes[id] = new DashboardItemDimensaoDto(col, alt);
                    }
                }
            }
            _dimensoes = dimensoes;
        }
        catch
        {
            // Se o MongoDB não estiver disponível ou falhar, mantém a ordem padrão sem bloquear o dashboard.
        }
    }

    private static bool EhSubconjuntoValido(IReadOnlyList<string>? ordem, string[] permitidos) =>
        ordem is not null
        && ordem.Count <= permitidos.Length
        && ordem.Distinct(StringComparer.Ordinal).Count() == ordem.Count
        && ordem.All(id => permitidos.Contains(id, StringComparer.Ordinal));

    private void IniciarEdicaoLayout()
    {
        _mensagemErro = null;
        _mensagemSucesso = null;
        _layoutAntesEdicao = new DashboardLayoutDto(
            _ordemKpis.ToList(),
            _ordemCards.ToList(),
            new Dictionary<string, DashboardItemDimensaoDto>(_dimensoes, StringComparer.Ordinal));
        _editandoLayout = true;
    }

    private void CancelarEdicaoLayout()
    {
        if (_layoutAntesEdicao is not null)
        {
            _ordemKpis = _layoutAntesEdicao.Kpis.ToList();
            _ordemCards = _layoutAntesEdicao.Cards.ToList();
            _dimensoes = _layoutAntesEdicao.Dimensoes is not null
                ? new Dictionary<string, DashboardItemDimensaoDto>(_layoutAntesEdicao.Dimensoes, StringComparer.Ordinal)
                : CriarDimensoesPadrao();
        }
        _editandoLayout = false;
        FinalizarArraste();
    }

    private void RestaurarLayoutPadrao()
    {
        _ordemKpis = [.. KpisPadrao];
        _ordemCards = [.. CardsPadrao];
        _dimensoes = CriarDimensoesPadrao();
    }

    private async Task SalvarLayoutAsync()
    {
        _salvandoLayout = true;
        _mensagemErro = null;
        _mensagemSucesso = null;
        try
        {
            await ApiClient.SalvarDashboardLayoutAsync(
                new DashboardLayoutDto(
                    _ordemKpis.ToList(),
                    _ordemCards.ToList(),
                    new Dictionary<string, DashboardItemDimensaoDto>(_dimensoes, StringComparer.Ordinal)));
            _editandoLayout = false;
            _layoutAntesEdicao = null;
            _mensagemSucesso = "Layout do dashboard salvo no MongoDB.";
        }
        catch (ApiException ex)
        {
            _mensagemErro = ex.Message;
        }
        catch (Exception ex)
        {
            _mensagemErro = "Erro ao salvar layout: " + ex.Message;
        }
        finally
        {
            _salvandoLayout = false;
            FinalizarArraste();
        }
    }

    private int ObterColunas(string id) =>
        _dimensoes.TryGetValue(id, out var d) ? d.Colunas : (KpisPadrao.Contains(id) ? 2 : 6);

    private string ObterAltura(string id) =>
        _dimensoes.TryGetValue(id, out var d) ? d.Altura : "auto";

    private bool PodeDiminuirLargura(string id)
    {
        var atual = ObterColunas(id);
        return OpcoesLargura.Any(o => o.Colunas < atual);
    }

    private bool PodeAumentarLargura(string id)
    {
        var atual = ObterColunas(id);
        return OpcoesLargura.Any(o => o.Colunas > atual);
    }

    private void AlterarLargura(string id, int direcao)
    {
        var atual = ObterColunas(id);
        var idx = Array.FindIndex(OpcoesLargura, o => o.Colunas == atual);
        if (idx < 0) idx = 0;
        var novoIdx = Math.Clamp(idx + direcao, 0, OpcoesLargura.Length - 1);
        var novasColunas = OpcoesLargura[novoIdx].Colunas;
        _dimensoes[id] = new DashboardItemDimensaoDto(novasColunas, ObterAltura(id));
    }

    private void DefinirLargura(string id, object? valor)
    {
        if (valor is not null && int.TryParse(valor.ToString(), out var col) && OpcoesLargura.Any(o => o.Colunas == col))
        {
            _dimensoes[id] = new DashboardItemDimensaoDto(col, ObterAltura(id));
        }
    }

    private void DefinirAltura(string id, object? valor)
    {
        var alt = valor?.ToString() ?? "auto";
        if (OpcoesAltura.Any(a => a.Codigo == alt))
        {
            _dimensoes[id] = new DashboardItemDimensaoDto(ObterColunas(id), alt);
        }
    }

    private void OcultarKpi(string kpiId)
    {
        _ordemKpis.Remove(kpiId);
    }

    private void OcultarCard(string cardId)
    {
        _ordemCards.Remove(cardId);
    }

    private void RestaurarItemOculto(string id, bool ehKpi)
    {
        if (ehKpi)
        {
            if (!_ordemKpis.Contains(id)) _ordemKpis.Add(id);
        }
        else
        {
            if (!_ordemCards.Contains(id)) _ordemCards.Add(id);
        }
    }

    private IReadOnlyList<MetadadosBlocoDashboard> ObterItensOcultos() =>
        CatalogoBlocos
            .Where(b => b.EhKpi ? !_ordemKpis.Contains(b.Id) : !_ordemCards.Contains(b.Id))
            .ToList();

    private void IniciarArrasteKpi(string kpiId)
    {
        if (!_editandoLayout) return;
        _kpiArrastando = kpiId;
        _cardArrastando = null;
    }

    private void IniciarArrasteItemOculto(string id, bool ehKpi)
    {
        if (!_editandoLayout) return;
        if (ehKpi)
        {
            _kpiArrastando = id;
            _cardArrastando = null;
        }
        else
        {
            _cardArrastando = id;
            _kpiArrastando = null;
        }
    }

    private void AoEntrarAlvoKpi(string kpiId)
    {
        if (_editandoLayout && _kpiArrastando is not null && _kpiArrastando != kpiId)
        {
            _kpiSobreAlvo = kpiId;
        }
    }

    private void SoltarKpi(string destinoId)
    {
        if (_editandoLayout && _kpiArrastando is not null && _kpiArrastando != destinoId)
        {
            ReordenarOuInserir(_ordemKpis, _kpiArrastando, destinoId);
        }
        FinalizarArraste();
    }

    private void SoltarEmAreaKpisVazia()
    {
        if (_editandoLayout && _kpiArrastando is not null && !_ordemKpis.Contains(_kpiArrastando))
        {
            _ordemKpis.Add(_kpiArrastando);
        }
        FinalizarArraste();
    }

    private void IniciarArrasteCard(string cardId)
    {
        if (!_editandoLayout) return;
        _cardArrastando = cardId;
        _kpiArrastando = null;
    }

    private void AoEntrarAlvoCard(string cardId)
    {
        if (_editandoLayout && _cardArrastando is not null && _cardArrastando != cardId)
        {
            _cardSobreAlvo = cardId;
        }
    }

    private void SoltarCard(string destinoId)
    {
        if (_editandoLayout && _cardArrastando is not null && _cardArrastando != destinoId)
        {
            ReordenarOuInserir(_ordemCards, _cardArrastando, destinoId);
        }
        FinalizarArraste();
    }

    private void SoltarEmAreaCardsVazia()
    {
        if (_editandoLayout && _cardArrastando is not null && !_ordemCards.Contains(_cardArrastando))
        {
            _ordemCards.Add(_cardArrastando);
        }
        FinalizarArraste();
    }

    private void AoEntrarBandejaOcultos()
    {
        if (!_editandoLayout) return;
        if ((_kpiArrastando is not null && _ordemKpis.Contains(_kpiArrastando))
            || (_cardArrastando is not null && _ordemCards.Contains(_cardArrastando)))
        {
            _sobreBandejaOcultos = true;
        }
    }

    private void SoltarNaBandejaOcultos()
    {
        if (_editandoLayout)
        {
            if (_kpiArrastando is not null)
            {
                _ordemKpis.Remove(_kpiArrastando);
            }
            if (_cardArrastando is not null)
            {
                _ordemCards.Remove(_cardArrastando);
            }
        }
        FinalizarArraste();
    }

    private void FinalizarArraste()
    {
        _kpiArrastando = null;
        _kpiSobreAlvo = null;
        _cardArrastando = null;
        _cardSobreAlvo = null;
        _sobreBandejaOcultos = false;
        _sobreAreaKpisVazia = false;
        _sobreAreaCardsVazia = false;
    }

    private static void ReordenarOuInserir(List<string> lista, string origemId, string destinoId)
    {
        var indiceDestino = lista.IndexOf(destinoId);
        if (indiceDestino < 0) return;

        var indiceOrigem = lista.IndexOf(origemId);
        if (indiceOrigem == indiceDestino) return;

        if (indiceOrigem >= 0)
        {
            lista.RemoveAt(indiceOrigem);
            indiceDestino = lista.IndexOf(destinoId);
        }

        lista.Insert(indiceDestino, origemId);
    }

    private string ObterClasseKpi(string id)
    {
        var classes = $"card kpi dash-col-{ObterColunas(id)} dash-h-{ObterAltura(id)}";
        if (!_editandoLayout) return classes;
        classes += " draggable-card";
        if (_kpiArrastando == id) classes += " is-dragging";
        if (_kpiSobreAlvo == id) classes += " drag-over";
        return classes;
    }

    private string ObterClasseCard(string id)
    {
        var baseClass = id switch
        {
            "alocacao-tipo" => "card allocation",
            "dividendos-recebidos" => "card dividends-chart",
            "aumento-capital" => "card capital-chart",
            "dividendos-por-tipo" => "card upcoming",
            "top10-papeis" => "card upcoming",
            _ => "card"
        };
        baseClass += $" dash-col-{ObterColunas(id)} dash-h-{ObterAltura(id)}";
        if (!_editandoLayout) return baseClass;
        if (_cardArrastando == id) baseClass += " is-dragging";
        if (_cardSobreAlvo == id) baseClass += " drag-over";
        return baseClass + " draggable-card";
    }

