@page "/transacoes"
@inject IInvestProMaxApiClient ApiClient
@inject NavigationManager Navegacao

<header class="page-header">
    <div>
        <div class="breadcrumb">InvestProMax <Icon Name="chevron" Size="12" /> Histórico operacional</div>
        <h1>Transações</h1>
    </div>
    <div class="page-actions">
        <a href="configuracoes" class="btn btn-secondary">
            <Icon Name="upload" Size="16" /><span>Importar B3</span>
        </a>
        <button type="button" class="btn btn-primary" @onclick="Novo">
            <Icon Name="plus" Size="16" /><span>Nova transação</span>
        </button>
    </div>
</header>

@if (_mensagemErro is not null)
{
    <div class="alerta-erro">@_mensagemErro</div>
}
@if (_mensagemSucesso is not null)
{
    <div class="alerta-sucesso">@_mensagemSucesso</div>
}

<div class="filter-bar">
    <label class="field" style="width: 190px;">
        <span>Filtrar por papel</span>
        <select @bind="_filtroPapelId" @bind:after="FiltrarAsync">
            <option value="">Todos os papéis</option>
            @if (_papeis is not null)
            {
                @foreach (var papel in _papeis)
                {
                    <option value="@papel.Id">@papel.Codigo — @papel.Nome</option>
                }
            }
        </select>
    </label>

    <label class="field" style="width: 140px;">
        <span>Tipo de papel</span>
        <select @bind="_filtroTipoPapel" @bind:after="FiltrarAsync">
            <option value="">Todos os tipos</option>
            @foreach (var tipo in Enum.GetValues<TipoPapel>())
            {
                <option value="@tipo">@tipo</option>
            }
        </select>
    </label>

    <label class="field" style="width: 130px;">
        <span>Tipo de operação</span>
        <select @bind="_filtroTipo" @bind:after="OnFiltroLocalAlterado">
            <option value="">Todas</option>
            <option value="Compra">Compra</option>
            <option value="Venda">Venda</option>
        </select>
    </label>

    <label class="field" style="width: 135px;">
        <span>Data início</span>
        <input type="date" @bind="_filtroDataInicio" @bind:after="FiltrarAsync" />
    </label>

    <label class="field" style="width: 135px;">
        <span>Data fim</span>
        <input type="date" @bind="_filtroDataFim" @bind:after="FiltrarAsync" />
    </label>

    <div class="search-field" style="margin-top: 19px;">
        <Icon Name="search" Size="16" />
        <input type="text" placeholder="Filtrar por descrição..." value="@_buscaTexto" @oninput="OnBuscaAlterada" />
    </div>
</div>

@if (_mensagemErro is not null && _todasTransacoes is null)
{
    <div class="card state-card">
        <div class="empty-icon" style="color: var(--danger); background: var(--danger-soft);">
            <Icon Name="alert" Size="28" />
        </div>
        <h2>Não foi possível carregar as transações</h2>
        <p style="max-width: 520px; margin: 8px auto 18px; color: var(--muted); font-size: 12px; line-height: 1.5;">@_mensagemErro</p>
        <button type="button" class="btn btn-primary" @onclick="CarregarAsync">
            <Icon Name="refresh" Size="16" /><span>Tentar novamente</span>
        </button>
    </div>
}
else if (_todasTransacoes is null)
{
    <LoadingState Mensagem="Carregando transações..." Subtitulo="Recuperando registros de compras e vendas." />
}
else
{
    var listaCompleta = ObterItensOrdenados().ToList();
    var totalRegistros = listaCompleta.Count;
    var totalPaginas = Math.Max(1, (int)Math.Ceiling((double)totalRegistros / _tamanhoPagina));
    if (_paginaAtual > totalPaginas) _paginaAtual = totalPaginas;

    var inicio = totalRegistros == 0 ? 0 : ((_paginaAtual - 1) * _tamanhoPagina) + 1;
    var fim = Math.Min(_paginaAtual * _tamanhoPagina, totalRegistros);
    var listaPagina = listaCompleta.Skip((_paginaAtual - 1) * _tamanhoPagina).Take(_tamanhoPagina).ToList();

    if (totalRegistros == 0)
    {
        <div class="card state-card">
            <div class="empty-icon"><Icon Name="transaction" Size="28" /></div>
            <h2>Nenhuma transação encontrada</h2>
            <p>Registre suas operações de compra e venda ou importe da B3.</p>
            <button type="button" class="btn btn-primary" @onclick="Novo">
                <Icon Name="plus" Size="16" /><span>Registrar primeira transação</span>
            </button>
        </div>
    }
    else
    {
        var totalOperado = listaPagina.Sum(t => t.Quantidade * t.ValorUnitario);
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th style="cursor:pointer;" @onclick='() => OrdenarPor("Papel")'>Papel @IndicadorOrdenacao("Papel")</th>
                        <th class="alinhar-centro" style="cursor:pointer;" @onclick='() => OrdenarPor("Tipo")'>Tipo @IndicadorOrdenacao("Tipo")</th>
                        <th class="alinhar-direita" style="cursor:pointer;" @onclick='() => OrdenarPor("Quantidade")'>Quantidade @IndicadorOrdenacao("Quantidade")</th>
                        <th class="alinhar-direita" style="cursor:pointer;" @onclick='() => OrdenarPor("ValorUnitario")'>Valor unitário @IndicadorOrdenacao("ValorUnitario")</th>
                        <th class="alinhar-direita" style="cursor:pointer;" @onclick='() => OrdenarPor("Total")'>Total @IndicadorOrdenacao("Total")</th>
                        <th class="alinhar-centro" style="cursor:pointer;" @onclick='() => OrdenarPor("Data")'>Data @IndicadorOrdenacao("Data")</th>
                        <th class="alinhar-centro" style="cursor:pointer;" @onclick='() => OrdenarPor("Historico")'>Histórico @IndicadorOrdenacao("Historico")</th>
                        <th style="cursor:pointer;" @onclick='() => OrdenarPor("Descricao")'>Descrição @IndicadorOrdenacao("Descricao")</th>
                        <th class="alinhar-direita">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transacao in listaPagina)
                    {
                        var total = transacao.Quantidade * transacao.ValorUnitario;
                        <tr>
                            <td>
                                <a class="paper-link" href="/papeis/@transacao.PapelId">@NomePapel(transacao.PapelId)</a>
                            </td>
                            <td class="alinhar-centro">
                                <span class="badge @(transacao.TipoTransacao == TipoTransacao.Compra ? "badge-positive" : "badge-negative")">
                                    @transacao.TipoTransacao
                                </span>
                            </td>
                            <td class="alinhar-direita">@transacao.Quantidade.ToString("N2")</td>
                            <td class="alinhar-direita">@transacao.ValorUnitario.ToString("C2")</td>
                            <td class="alinhar-direita font-bold">@total.ToString("C2")</td>
                            <td class="alinhar-centro">@transacao.Data.ToString("dd/MM/yyyy")</td>
                            <td class="alinhar-centro">
                                <span class="badge @(transacao.Historico ? "badge-info" : "badge-neutral")">
                                    @(transacao.Historico ? "Sim" : "Não")
                                </span>
                            </td>
                            <td style="color:var(--muted);max-width:260px;overflow:hidden;text-overflow:ellipsis;">@transacao.Descricao</td>
                            <td class="alinhar-direita">
                                <div class="row-actions">
                                    <button type="button" title="Editar" @onclick="() => Editar(transacao)"><Icon Name="edit" Size="14" /></button>
                                    <button type="button" class="danger" title="Remover" @onclick="() => RemoverAsync(transacao)"><Icon Name="trash" Size="14" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-footer">
                <strong>Total operado (página): @totalOperado.ToString("C2")</strong>
                <span>Mostrando @inicio–@fim de @totalRegistros transações</span>
                <PaginacaoGrid PaginaAtual="_paginaAtual" TotalPaginas="totalPaginas" OnPaginaMudou="MudarPagina" />
            </div>
        </div>
    }
}

<!-- Drawer: Nova / Editar Transação -->
@if (_modelo is not null)
{
    <div class="overlay">
        <button type="button" class="overlay-close" @onclick="Cancelar"></button>
        <div class="drawer">
            <div class="drawer-head">
                <div>
                    <span>Formulário de lançamento</span>
                    <h2>@(_editandoId is null ? "Nova transação" : "Editar transação")</h2>
                </div>
                <button type="button" class="icon-btn" @onclick="Cancelar"><Icon Name="close" Size="18" /></button>
            </div>

            <EditForm Model="_modelo" OnValidSubmit="SalvarAsync" style="display:flex;flex-direction:column;flex:1;overflow:hidden;">
                <DataAnnotationsValidator />
                
                <div class="drawer-body">
                    @if (_editandoId is null)
                    {
                        <div class="field">
                            <span>Papel</span>
                            <InputSelect @bind-Value="_modelo.PapelId">
                                <option value="">Selecione o papel...</option>
                                @if (_papeis is not null)
                                {
                                    @foreach (var papel in _papeis)
                                    {
                                        <option value="@papel.Id">@papel.Codigo — @papel.Nome</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _modelo.PapelId)" />
                        </div>
                    }

                    <div class="field">
                        <span>Tipo de transação</span>
                        <InputSelect @bind-Value="_modelo.TipoTransacao">
                            @foreach (var tipo in Enum.GetValues<TipoTransacao>())
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <span>Quantidade</span>
                            <InputNumber @bind-Value="_modelo.Quantidade" step="0.01" />
                            <ValidationMessage For="@(() => _modelo.Quantidade)" />
                        </div>
                        <div class="field">
                            <span>Valor unitário (R$)</span>
                            <InputNumber @bind-Value="_modelo.ValorUnitario" step="0.01" />
                            <ValidationMessage For="@(() => _modelo.ValorUnitario)" />
                        </div>
                    </div>

                    <div class="field">
                        <span>Data da operação</span>
                        <InputDate @bind-Value="_modelo.Data" />
                        <ValidationMessage For="@(() => _modelo.Data)" />
                    </div>

                    <div class="field">
                        <span>Descrição (opcional)</span>
                        <InputText @bind-Value="_modelo.Descricao" placeholder="Ex: Aporte mensal, rebalanceamento..." />
                    </div>
                </div>

                <div class="drawer-actions">
                    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    <button type="submit" class="btn btn-primary" disabled="@_salvando">
                        @(_salvando ? "Salvando..." : "Salvar transação")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<TransacaoResponse>? _todasTransacoes;
    private IReadOnlyList<PapelResponse>? _papeis;
    private string _filtroPapelId = string.Empty;
    private string _filtroTipoPapel = string.Empty;
    private string _filtroTipo = string.Empty;
    private DateOnly? _filtroDataInicio;
    private DateOnly? _filtroDataFim;
    private string _buscaTexto = string.Empty;
    private string? _mensagemErro;
    private string? _mensagemSucesso;
    private bool _salvando;

    private string _colunaOrdenacao = "Data";
    private bool _ordenacaoAscendente = false;
    private int _paginaAtual = 1;
    private const int _tamanhoPagina = 10;

    private Guid? _editandoId;
    private FormTransacao? _modelo;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task FiltrarAsync()
    {
        _paginaAtual = 1;
        await CarregarAsync();
    }

    private void OnFiltroLocalAlterado()
    {
        _paginaAtual = 1;
    }

    private void OnBuscaAlterada(ChangeEventArgs e)
    {
        _buscaTexto = e.Value?.ToString() ?? string.Empty;
        _paginaAtual = 1;
    }

    private void MudarPagina(int novaPagina)
    {
        if (novaPagina < 1) return;
        _paginaAtual = novaPagina;
    }

    private void OrdenarPor(string coluna)
    {
        if (_colunaOrdenacao == coluna)
        {
            _ordenacaoAscendente = !_ordenacaoAscendente;
        }
        else
        {
            _colunaOrdenacao = coluna;
            _ordenacaoAscendente = true;
        }
        _paginaAtual = 1;
    }

    private string IndicadorOrdenacao(string coluna)
    {
        if (_colunaOrdenacao != coluna) return "↕";
        return _ordenacaoAscendente ? "↑" : "↓";
    }

    private IEnumerable<TransacaoResponse> ObterItensOrdenados()
    {
        if (_todasTransacoes is null) return [];
        var itens = _todasTransacoes.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_filtroTipo) && Enum.TryParse<TipoTransacao>(_filtroTipo, out var t))
        {
            itens = itens.Where(x => x.TipoTransacao == t);
        }

        if (!string.IsNullOrWhiteSpace(_buscaTexto))
        {
            var termo = _buscaTexto.Trim();
            itens = itens.Where(x =>
                (x.Descricao ?? string.Empty).Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                NomePapel(x.PapelId).Contains(termo, StringComparison.OrdinalIgnoreCase));
        }

        return _colunaOrdenacao switch
        {
            "Papel" => _ordenacaoAscendente ? itens.OrderBy(x => NomePapel(x.PapelId)) : itens.OrderByDescending(x => NomePapel(x.PapelId)),
            "Tipo" => _ordenacaoAscendente ? itens.OrderBy(x => x.TipoTransacao) : itens.OrderByDescending(x => x.TipoTransacao),
            "Quantidade" => _ordenacaoAscendente ? itens.OrderBy(x => x.Quantidade) : itens.OrderByDescending(x => x.Quantidade),
            "ValorUnitario" => _ordenacaoAscendente ? itens.OrderBy(x => x.ValorUnitario) : itens.OrderByDescending(x => x.ValorUnitario),
            "Total" => _ordenacaoAscendente ? itens.OrderBy(x => x.Quantidade * x.ValorUnitario) : itens.OrderByDescending(x => x.Quantidade * x.ValorUnitario),
            "Data" => _ordenacaoAscendente ? itens.OrderBy(x => x.Data).ThenBy(x => x.Id) : itens.OrderByDescending(x => x.Data).ThenBy(x => x.Id),
            "Historico" => _ordenacaoAscendente ? itens.OrderBy(x => x.Historico) : itens.OrderByDescending(x => x.Historico),
            "Descricao" => _ordenacaoAscendente ? itens.OrderBy(x => x.Descricao ?? string.Empty) : itens.OrderByDescending(x => x.Descricao ?? string.Empty),
            _ => itens.OrderByDescending(x => x.Data)
        };
    }

    private async Task CarregarPapeisAsync()
    {
        var todos = new List<PapelResponse>();
        var pagina = 1;
        while (true)
        {
            var r = await ApiClient.ListarPapeisAsync(page: pagina, pageSize: 5000);
            todos.AddRange(r.Itens);
            if (todos.Count >= r.Total || r.Itens.Count == 0)
            {
                break;
            }
            pagina++;
        }
        _papeis = todos;
    }

    private async Task CarregarAsync()
    {
        _mensagemErro = null;
        try
        {
            if (_papeis is null)
            {
                await CarregarPapeisAsync();
            }

            Guid? papelId = Guid.TryParse(_filtroPapelId, out var id) ? id : null;
            TipoPapel? tipoPapel = Enum.TryParse<TipoPapel>(_filtroTipoPapel, out var tp) ? tp : null;

            var primeira = await ApiClient.ListarTransacoesAsync(
                papelId: papelId,
                tipoPapel: tipoPapel,
                dataInicio: _filtroDataInicio,
                dataFim: _filtroDataFim,
                page: 1,
                pageSize: 5000);

            var todos = new List<TransacaoResponse>(primeira.Total);
            todos.AddRange(primeira.Itens);

            if (todos.Count < primeira.Total && primeira.Itens.Count > 0)
            {
                var tamanhoEfetivo = primeira.Itens.Count;
                var totalPaginasApi = (int)Math.Ceiling((double)primeira.Total / tamanhoEfetivo);
                var tarefas = new List<Task<PaginaResultado<TransacaoResponse>>>();
                for (var p = 2; p <= totalPaginasApi; p++)
                {
                    var pag = p;
                    tarefas.Add(ApiClient.ListarTransacoesAsync(
                        papelId: papelId,
                        tipoPapel: tipoPapel,
                        dataInicio: _filtroDataInicio,
                        dataFim: _filtroDataFim,
                        page: pag,
                        pageSize: tamanhoEfetivo));
                }

                var resultados = await Task.WhenAll(tarefas);
                foreach (var res in resultados)
                {
                    todos.AddRange(res.Itens);
                }
            }

            _todasTransacoes = todos;
        }
        catch (ApiException ex) when (ex.EhNaoAutorizado)
        {
            Navegacao.NavigateTo("/login", forceLoad: false);
        }
        catch (ApiException ex)
        {
            _mensagemErro = ex.Message;
        }
    }

    private string NomePapel(Guid papelId)
    {
        var papel = _papeis?.FirstOrDefault(p => p.Id == papelId);
        return papel is not null ? $"{papel.Codigo}" : papelId.ToString()[..8];
    }

    private void Novo()
    {
        _editandoId = null;
        _modelo = new FormTransacao();
    }

    private void Editar(TransacaoResponse t)
    {
        _editandoId = t.Id;
        _modelo = new FormTransacao
        {
            PapelId = t.PapelId,
            TipoTransacao = t.TipoTransacao,
            Quantidade = t.Quantidade,
            ValorUnitario = t.ValorUnitario,
            Data = t.Data,
            Descricao = t.Descricao
        };
    }

    private void Cancelar()
    {
        _modelo = null;
        _editandoId = null;
    }

    private async Task SalvarAsync()
    {
        if (_modelo is null) return;
        _salvando = true;
        _mensagemErro = null;
        _mensagemSucesso = null;
        try
        {
            if (_editandoId is null)
            {
                await ApiClient.CriarTransacaoAsync(new CriarTransacaoRequest(
                    _modelo.PapelId,
                    _modelo.TipoTransacao,
                    _modelo.Quantidade,
                    _modelo.ValorUnitario,
                    _modelo.Data,
                    _modelo.Descricao));
                _mensagemSucesso = "Transação registrada com sucesso!";
            }
            else
            {
                await ApiClient.AtualizarTransacaoAsync(_editandoId.Value, new AtualizarTransacaoRequest(
                    _modelo.TipoTransacao,
                    _modelo.Quantidade,
                    _modelo.ValorUnitario,
                    _modelo.Data,
                    _modelo.Descricao));
                _mensagemSucesso = "Transação atualizada com sucesso!";
            }
            _modelo = null;
            _editandoId = null;
            await CarregarAsync();
        }
        catch (ApiException ex)
        {
            _mensagemErro = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task RemoverAsync(TransacaoResponse t)
    {
        _mensagemErro = null;
        _mensagemSucesso = null;
        try
        {
            await ApiClient.RemoverTransacaoAsync(t.Id);
            _mensagemSucesso = "Transação removida com sucesso.";
            await CarregarAsync();
        }
        catch (ApiException ex)
        {
            _mensagemErro = ex.Message;
        }
    }

    private sealed class FormTransacao
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Selecione o papel.")]
        public Guid PapelId { get; set; }

        public TipoTransacao TipoTransacao { get; set; } = TipoTransacao.Compra;

        [System.ComponentModel.DataAnnotations.Range(0.000001, double.MaxValue, ErrorMessage = "A quantidade deve ser positiva.")]
        public decimal Quantidade { get; set; } = 1;

        [System.ComponentModel.DataAnnotations.Range(0, double.MaxValue, ErrorMessage = "O valor unitário não pode ser negativo.")]
        public decimal ValorUnitario { get; set; }

        public DateOnly Data { get; set; } = DateOnly.FromDateTime(DateTime.Today);

        public string? Descricao { get; set; }
    }
}
