                <span style="color: var(--muted); font-size: 12px;">
                    Sincronizado às @_infoAmbiente.DataHoraServidorUtc.ToLocalTime().ToString("HH:mm:ss")
                </span>
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "aba")]
    public string? AbaQuery { get; set; }

    private string _abaAtiva = "importacao";
    private bool _temaEscuro;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var tema = await Js.InvokeAsync<string>("investProMaxGetTheme");
                _temaEscuro = string.Equals(tema, "dark", StringComparison.OrdinalIgnoreCase);
                StateHasChanged();
            }
            catch
            {
                // Ignora caso o script não esteja disponível
            }
        }
    }

    private async Task AlternarTemaAsync()
    {
        _temaEscuro = !_temaEscuro;
        var novoTema = _temaEscuro ? "dark" : "light";
        try
        {
            await Js.InvokeVoidAsync("investProMaxSetTheme", novoTema);
        }
        catch
        {
            // Ignora falha de JS interop
        }
    }

    private async Task SairAsync()
    {
        await ApiClient.LogoutAsync();
        Navegacao.NavigateTo("/login", forceLoad: false);
    }

    private static string ObterIniciais(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "US";
        var partes = nome.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length >= 2)
        {
            return $"{char.ToUpperInvariant(partes[0][0])}{char.ToUpperInvariant(partes[1][0])}";
        }
        return nome.Length >= 2
            ? nome[..2].ToUpperInvariant()
            : nome.ToUpperInvariant();
    }
