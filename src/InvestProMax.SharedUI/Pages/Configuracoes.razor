@page "/configuracoes"
@inject IInvestProMaxApiClient ApiClient
@inject AuthState AuthState
@inject IJSRuntime Js
@inject NavigationManager Navegacao

<header class="page-header">
    <div>
        <div class="breadcrumb">InvestProMax <Icon Name="chevron" Size="12" /> Sistema</div>
        <h1>Configurações</h1>
    </div>
</header>

<div class="subnav">
    <button type="button" class="@(_abaAtiva == "perfil" ? "active" : "")" @onclick="@(() => _abaAtiva = "perfil")">
        Opções do Usuário
    </button>
    <button type="button" class="@(_abaAtiva == "importacao" ? "active" : "")" @onclick="@(() => _abaAtiva = "importacao")">
        Importação e backup
    </button>
    <button type="button" class="@(_abaAtiva == "conta" ? "active" : "")" @onclick="@(() => _abaAtiva = "conta")">
        Minha conta
    </button>
    @if (EhAdmin)
    {
        <button type="button" class="@(_abaAtiva == "usuarios" ? "active" : "")" @onclick="AbrirAbaUsuariosAsync">
            Usuários
        </button>
    }
    <button type="button" class="@(_abaAtiva == "ambiente" ? "active" : "")" @onclick="AbrirAbaAmbienteAsync">
        Ambiente e Conexões
    </button>
</div>

@if (_processando)
{
    <div class="overlay modal-overlay" style="z-index: 1200;">
        <div class="modal" style="max-width: 440px;">
            <LoadingState Mensagem="Processando operação..." Subtitulo="Aguarde enquanto importamos e salvamos os dados." />
        </div>
    </div>
}

@if (_mensagemErro is not null)
{
    <div class="alerta-erro">@_mensagemErro</div>
}
@if (_mensagemSucesso is not null)
{
    <div class="alerta-sucesso">@_mensagemSucesso</div>
}

@if (_abaAtiva == "perfil")
{
    <section class="card" style="max-width: 480px; padding: 0; overflow: hidden;">
        <div class="user-popover-head">
            <div class="avatar avatar-lg">@ObterIniciais(AuthState.NomeUsuario)</div>
            <div class="user-popover-info">
                <div class="user-popover-name">@(AuthState.NomeUsuario ?? "Usuário")</div>
                <div class="user-popover-sub">InvestProMax</div>
                <span class="user-role-badge">@(EhAdmin ? "Administrador" : "Usuário")</span>
            </div>
        </div>

        <div class="user-popover-menu">
            <button type="button" class="user-popover-item" @onclick="AlternarTemaAsync">
                <Icon Name="@(_temaEscuro ? "sun" : "moon")" Size="16" />
                <div class="user-popover-item-body">
                    <span>@(_temaEscuro ? "Tema claro" : "Tema escuro")</span>
                    <small>Alternar para visualização @(_temaEscuro ? "clara" : "escura")</small>
                </div>
            </button>

            <button type="button" class="user-popover-item" @onclick="@(() => _abaAtiva = "conta")">
                <Icon Name="settings" Size="16" />
                <div class="user-popover-item-body">
                    <span>Trocar de senha</span>
                    <small>Atualizar credenciais de acesso</small>
                </div>
            </button>

            <button type="button" class="user-popover-item" @onclick="@(() => _abaAtiva = "conta")">
                <Icon Name="user" Size="16" />
                <div class="user-popover-item-body">
                    <span>Minha conta / E-mail</span>
                    <small>Gerenciar dados cadastrais</small>
                </div>
            </button>

            @if (EhAdmin)
            {
                <button type="button" class="user-popover-item" @onclick="AbrirAbaUsuariosAsync">
                    <Icon Name="assets" Size="16" />
                    <div class="user-popover-item-body">
                        <span>Gerenciar usuários</span>
                        <small>Criar e administrar contas</small>
                    </div>
                </button>
            }
        </div>

        <button type="button" class="user-popover-item logout-item" @onclick="SairAsync">
            <Icon Name="logout" Size="16" />
            <div class="user-popover-item-body">
                <span>Sair da aplicação</span>
            </div>
        </button>
    </section>
}

@if (_abaAtiva == "importacao")
{
    <!-- Upload Cards Grid -->
    <div class="upload-grid">
        <label class="card upload-card" style="cursor: pointer; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
            <div class="upload-icon"><Icon Name="upload" Size="22" /></div>
            <h2>Extrato B3 (.xlsx)</h2>
            <p>Transações, dividendos e aluguéis</p>
            <div style="margin-top: 14px;">
                <span class="btn btn-secondary" style="font-size: 11px; pointer-events: none;">
                    @(_processando ? "Processando..." : "Selecionar planilha")
                </span>
            </div>
            <InputFile OnChange="e => ImportarAsync(e, ApiClient.ImportarB3Async)" disabled="@_processando" style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" />
        </label>

        <label class="card upload-card" style="cursor: pointer; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
            <div class="upload-icon"><Icon Name="stocks" Size="22" /></div>
            <h2>Cotações (.xlsx)</h2>
            <p>Cotações históricas e fechamento</p>
            <div style="margin-top: 14px;">
                <span class="btn btn-secondary" style="font-size: 11px; pointer-events: none;">
                    @(_processando ? "Processando..." : "Selecionar planilha")
                </span>
            </div>
            <InputFile OnChange="e => ImportarAsync(e, ApiClient.ImportarCotacoesAsync)" disabled="@_processando" style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" />
        </label>

        <label class="card upload-card" style="cursor: pointer; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
            <div class="upload-icon"><Icon Name="refresh" Size="22" /></div>
            <h2>Restaurar backup (.xlsx)</h2>
            <p>Restaura carteira a partir de arquivo de backup</p>
            <div style="margin-top: 14px;">
                <span class="btn btn-secondary" style="font-size: 11px; pointer-events: none;">
                    @(_processando ? "Processando..." : "Selecionar backup")
                </span>
            </div>
            <InputFile OnChange="RestaurarBackupAsync" disabled="@_processando" style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;" />
        </label>
    </div>

    <!-- Import Summary Widgets -->
    @if (_ultimoResultadoB3 is not null)
    {
        <section class="card import-summary">
            <div class="section-title">
                <div>
                    <h2>Resumo da importação B3</h2>
                    <p>Métricas extraídas e processadas da planilha do extrato</p>
                </div>
                <span class="badge badge-positive">Sucesso</span>
            </div>
            <div>
                <span>
                    <small>PAPÉIS CRIADOS</small>
                    <strong>@_ultimoResultadoB3.PapeisCriados</strong>
                </span>
                <span>
                    <small>TRANSAÇÕES</small>
                    <strong>@_ultimoResultadoB3.TransacoesCriadas</strong>
                </span>
                <span>
                    <small>DIVIDENDOS</small>
                    <strong>@_ultimoResultadoB3.DividendosCriados</strong>
                </span>
                <span>
                    <small>ALUGUÉIS</small>
                    <strong>@_ultimoResultadoB3.MovimentosAluguelCriados</strong>
                </span>
                <span>
                    <small>DUPLICADAS (IGNORADAS)</small>
                    <strong>@_ultimoResultadoB3.LinhasIgnoradasDuplicadas</strong>
                </span>
                <span>
                    <small>NÃO RECONHECIDAS</small>
                    <strong>@_ultimoResultadoB3.LinhasIgnoradasNaoReconhecidas</strong>
                </span>
            </div>
        </section>

        <!-- Grid de transações importadas da B3 -->
        <section class="card" style="margin-top: 18px;">
            <div class="section-title" style="flex-wrap: wrap; gap: 12px;">
                <div>
                    <h2>Transações importadas da B3</h2>
                    <p>Visualização das operações processadas e registradas nesta importação (duplicadas ignoradas)</p>
                </div>
                @if (_ultimoResultadoB3.Dividendos is { Count: > 0 })
                {
                    <div style="display: flex; gap: 6px;">
                        <button type="button" class="btn @(_gridB3Aba == "transacoes" ? "btn-primary" : "btn-secondary")"
                                style="font-size: 11px; padding: 5px 10px;"
                                @onclick='() => SelecionarGridB3Aba("transacoes")'>
                            <Icon Name="transaction" Size="14" />
                            <span>Transações (@(_ultimoResultadoB3.Transacoes?.Count ?? 0))</span>
                        </button>
                        <button type="button" class="btn @(_gridB3Aba == "dividendos" ? "btn-primary" : "btn-secondary")"
                                style="font-size: 11px; padding: 5px 10px;"
                                @onclick='() => SelecionarGridB3Aba("dividendos")'>
                            <Icon Name="dividend" Size="14" />
                            <span>Proventos (@_ultimoResultadoB3.Dividendos.Count)</span>
                        </button>
                    </div>
                }
            </div>

            <!-- Filtros do grid -->
            <div class="filter-bar" style="margin-top: 12px; margin-bottom: 14px; gap: 12px; flex-wrap: wrap;">
                @if (_gridB3Aba == "transacoes")
                {
                    <label class="field" style="width: 140px;">
                        <span>Tipo de operação</span>
                        <select @bind="_gridB3FiltroTipo" @bind:after="OnGridB3FiltroAlterado">
                            <option value="">Todas</option>
                            <option value="Compra">Compra</option>
                            <option value="Venda">Venda</option>
                        </select>
                    </label>
                }
                else
                {
                    <label class="field" style="width: 140px;">
                        <span>Tipo de provento</span>
                        <select @bind="_gridB3FiltroTipoDividendo" @bind:after="OnGridB3FiltroAlterado">
                            <option value="">Todos</option>
                            <option value="Dividendo">Dividendo</option>
                            <option value="JSCP">JSCP</option>
                            <option value="Rendimento">Rendimento</option>
                            <option value="Aluguel">Aluguel</option>
                            <option value="Outro">Outro</option>
                        </select>
                    </label>
                }

                <div class="search-field" style="margin-top: 19px; flex: 1; min-width: 200px;">
                    <Icon Name="search" Size="16" />
                    <input type="text" placeholder="Filtrar por papel ou descrição..." value="@_gridB3Busca" @oninput="OnGridB3BuscaAlterada" />
                </div>
            </div>

            @if (_gridB3Aba == "transacoes")
            {
                var transacoesFiltradas = ObterTransacoesB3Filtradas().ToList();
                var total = transacoesFiltradas.Count;
                var totalPaginas = Math.Max(1, (int)Math.Ceiling((double)total / _gridB3TamanhoPagina));
                if (_gridB3PaginaAtual > totalPaginas) _gridB3PaginaAtual = totalPaginas;

                var inicio = total == 0 ? 0 : ((_gridB3PaginaAtual - 1) * _gridB3TamanhoPagina) + 1;
                var fim = Math.Min(_gridB3PaginaAtual * _gridB3TamanhoPagina, total);
                var itensPagina = transacoesFiltradas.Skip((_gridB3PaginaAtual - 1) * _gridB3TamanhoPagina).Take(_gridB3TamanhoPagina).ToList();

                if (total == 0)
                {
                    <div style="padding: 28px; text-align: center; color: var(--muted); font-size: 13px;">
                        @if ((_ultimoResultadoB3.Transacoes?.Count ?? 0) == 0)
                        {
                            <span>Nenhuma transação nova importada nesta planilha (as linhas existentes foram ignoradas por já constarem na base).</span>
                        }
                        else
                        {
                            <span>Nenhuma transação corresponde aos filtros informados.</span>
                        }
                    </div>
                }
                else
                {
                    var totalOperado = itensPagina.Sum(t => t.ValorTotal);
                    <div class="table-shell">
                        <table>
                            <thead>
                                <tr>
                                    <th class="alinhar-centro" style="cursor:pointer;" @onclick='() => OrdenarGridB3("Data")'>
                                        Data @IndicadorOrdenacaoGridB3("Data")
                                    </th>
                                    <th style="cursor:pointer;" @onclick='() => OrdenarGridB3("Papel")'>
                                        Papel @IndicadorOrdenacaoGridB3("Papel")
                                    </th>
                                    <th class="alinhar-centro" style="cursor:pointer;" @onclick='() => OrdenarGridB3("Tipo")'>
                                        Tipo @IndicadorOrdenacaoGridB3("Tipo")
                                    </th>
                                    <th class="alinhar-direita" style="cursor:pointer;" @onclick='() => OrdenarGridB3("Quantidade")'>
                                        Quantidade @IndicadorOrdenacaoGridB3("Quantidade")
                                    </th>
                                    <th class="alinhar-direita" style="cursor:pointer;" @onclick='() => OrdenarGridB3("ValorUnitario")'>
                                        Valor unitário @IndicadorOrdenacaoGridB3("ValorUnitario")
                                    </th>
                                    <th class="alinhar-direita" style="cursor:pointer;" @onclick='() => OrdenarGridB3("ValorTotal")'>
                                        Total @IndicadorOrdenacaoGridB3("ValorTotal")
                                    </th>
                                    <th style="cursor:pointer;" @onclick='() => OrdenarGridB3("Descricao")'>
                                        Descrição / Movimentação @IndicadorOrdenacaoGridB3("Descricao")
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in itensPagina)
                                {
                                    <tr>
                                        <td class="alinhar-centro">@item.Data.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <a class="paper-link" href="/papeis/@item.PapelId"><strong>@item.Codigo</strong></a>
                                            @if (!string.IsNullOrWhiteSpace(item.NomePapel))
                                            {
                                                <small style="display:block;color:var(--muted);font-size:11px;">@item.NomePapel</small>
                                            }
                                        </td>
                                        <td class="alinhar-centro">
                                            <span class="badge @(item.TipoTransacao == TipoTransacao.Compra ? "badge-positive" : "badge-negative")">
                                                @item.TipoTransacao
                                            </span>
                                        </td>
                                        <td class="alinhar-direita">@item.Quantidade.ToString("N2")</td>
                                        <td class="alinhar-direita">@item.ValorUnitario.ToString("C2")</td>
                                        <td class="alinhar-direita font-bold">@item.ValorTotal.ToString("C2")</td>
                                        <td style="color:var(--muted);max-width:280px;overflow:hidden;text-overflow:ellipsis;">@item.Descricao</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="table-footer">
                            <strong>Total operado (página): @totalOperado.ToString("C2")</strong>
                            <span>Mostrando @inicio–@fim de @total transações</span>
                            <PaginacaoGrid PaginaAtual="_gridB3PaginaAtual" TotalPaginas="totalPaginas" @bind-TamanhoPagina="_gridB3TamanhoPagina" OnPaginaMudou="MudarPaginaGridB3" />
                        </div>
                    </div>
                }
            }
            else
            {
                var dividendosFiltrados = ObterDividendosB3Filtrados().ToList();
                var total = dividendosFiltrados.Count;
                var totalPaginas = Math.Max(1, (int)Math.Ceiling((double)total / _gridB3TamanhoPagina));
                if (_gridB3PaginaAtual > totalPaginas) _gridB3PaginaAtual = totalPaginas;

                var inicio = total == 0 ? 0 : ((_gridB3PaginaAtual - 1) * _gridB3TamanhoPagina) + 1;
                var fim = Math.Min(_gridB3PaginaAtual * _gridB3TamanhoPagina, total);
                var itensPagina = dividendosFiltrados.Skip((_gridB3PaginaAtual - 1) * _gridB3TamanhoPagina).Take(_gridB3TamanhoPagina).ToList();

                if (total == 0)
                {
                    <div style="padding: 28px; text-align: center; color: var(--muted); font-size: 13px;">
                        <span>Nenhum provento corresponde aos filtros informados.</span>
                    </div>
                }
                else
                {
                    var totalRecebido = itensPagina.Sum(d => d.ValorRecebido);
                    <div class="table-shell">
                        <table>
                            <thead>
                                <tr>
                                    <th class="alinhar-centro" style="cursor:pointer;" @onclick='() => OrdenarGridB3("Data")'>
                                        Data @IndicadorOrdenacaoGridB3("Data")
                                    </th>
                                    <th style="cursor:pointer;" @onclick='() => OrdenarGridB3("Papel")'>
                                        Papel @IndicadorOrdenacaoGridB3("Papel")
                                    </th>
                                    <th class="alinhar-centro" style="cursor:pointer;" @onclick='() => OrdenarGridB3("TipoDividendo")'>
                                        Tipo @IndicadorOrdenacaoGridB3("TipoDividendo")
                                    </th>
                                    <th class="alinhar-direita" style="cursor:pointer;" @onclick='() => OrdenarGridB3("Quantidade")'>
                                        Quantidade @IndicadorOrdenacaoGridB3("Quantidade")
                                    </th>
                                    <th class="alinhar-direita" style="cursor:pointer;" @onclick='() => OrdenarGridB3("ValorRecebido")'>
                                        Valor recebido @IndicadorOrdenacaoGridB3("ValorRecebido")
                                    </th>
                                    <th style="cursor:pointer;" @onclick='() => OrdenarGridB3("Descricao")'>
                                        Descrição / Movimentação @IndicadorOrdenacaoGridB3("Descricao")
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in itensPagina)
                                {
                                    <tr>
                                        <td class="alinhar-centro">@item.Data.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <a class="paper-link" href="/papeis/@item.PapelId"><strong>@item.Codigo</strong></a>
                                            @if (!string.IsNullOrWhiteSpace(item.NomePapel))
                                            {
                                                <small style="display:block;color:var(--muted);font-size:11px;">@item.NomePapel</small>
                                            }
                                        </td>
                                        <td class="alinhar-centro">
                                            <span class="badge badge-info">@item.TipoDividendo</span>
                                        </td>
                                        <td class="alinhar-direita">@item.Quantidade.ToString("N2")</td>
                                        <td class="alinhar-direita font-bold">@item.ValorRecebido.ToString("C2")</td>
                                        <td style="color:var(--muted);max-width:280px;overflow:hidden;text-overflow:ellipsis;">@item.Descricao</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="table-footer">
                            <strong>Total recebido (página): @totalRecebido.ToString("C2")</strong>
                            <span>Mostrando @inicio–@fim de @total proventos</span>
                            <PaginacaoGrid PaginaAtual="_gridB3PaginaAtual" TotalPaginas="totalPaginas" @bind-TamanhoPagina="_gridB3TamanhoPagina" OnPaginaMudou="MudarPaginaGridB3" />
                        </div>
                    </div>
                }
            }
        </section>
    }
    else if (_ultimoResultadoCotacoes is not null)
    {
        <section class="card import-summary">
            <div class="section-title">
                <div>
                    <h2>Resumo da importação de cotações</h2>
                    <p>Atualização de cotações a partir da planilha</p>
                </div>
                <span class="badge badge-positive">Sucesso</span>
            </div>
            <div style="grid-template-columns: repeat(2, 1fr);">
                <span>
                    <small>COTAÇÕES ATUALIZADAS</small>
                    <strong>@_ultimoResultadoCotacoes.CotacoesAtualizadas</strong>
                </span>
                <span>
                    <small>NÃO ENCONTRADOS</small>
                    <strong>@_ultimoResultadoCotacoes.CodigosNaoEncontrados.Count</strong>
                </span>
            </div>
        </section>
    }
    else if (_ultimoResultadoRestauracao is not null)
    {
        <section class="card import-summary">
            <div class="section-title">
                <div>
                    <h2>Resumo da restauração de backup</h2>
                    <p>Registros importados e mesclados com a base de dados</p>
                </div>
                <span class="badge badge-positive">Sucesso</span>
            </div>
            <div>
                <span>
                    <small>PAPÉIS (+ / UPD)</small>
                    <strong>@_ultimoResultadoRestauracao.PapeisCriados / @_ultimoResultadoRestauracao.PapeisAtualizados</strong>
                </span>
                <span>
                    <small>TRANSAÇÕES (+ / UPD)</small>
                    <strong>@_ultimoResultadoRestauracao.TransacoesCriadas / @_ultimoResultadoRestauracao.TransacoesAtualizadas</strong>
                </span>
                <span>
                    <small>DIVIDENDOS (+ / UPD)</small>
                    <strong>@_ultimoResultadoRestauracao.DividendosCriados / @_ultimoResultadoRestauracao.DividendosAtualizados</strong>
                </span>
                <span>
                    <small>ALUGUÉIS (+ / UPD)</small>
                    <strong>@_ultimoResultadoRestauracao.AlugueisCriados / @_ultimoResultadoRestauracao.AlugueisAtualizados</strong>
                </span>
            </div>
        </section>
    }

    <!-- Excel Backup Banner -->
    <div class="backup-row">
        <div>
            <h2>Backup completo da carteira (.xlsx)</h2>
            <p>Baixe um arquivo Excel contendo todas as tabelas e dados para segurança ou migração externa.</p>
        </div>
        <button type="button" class="btn btn-secondary" @onclick="BaixarBackupAsync" disabled="@_processando" style="white-space: nowrap;">
            <Icon Name="upload" Size="16" />
            <span>@(_processando ? "Gerando backup..." : "Baixar backup (.xlsx)")</span>
        </button>
    </div>

    <!-- MongoDB Atlas Backup Banner -->
    <div class="backup-row" style="margin-top: 14px; border-left: 3px solid #10b981;">
        <div>
            <h2>Backup em Nuvem no MongoDB Atlas</h2>
            <p>Sincroniza todas as tabelas na nuvem (MongoDB Atlas) com coleções prefixadas como <code>IPM_Nome_Tabela</code>.</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="ExecutarBackupMongoAsync" disabled="@_processando" style="white-space: nowrap;">
            <Icon Name="refresh" Size="16" />
            <span>@(_processandoMongo ? "Sincronizando MongoDB..." : "Fazer backup no MongoDB agora")</span>
        </button>
    </div>

    @if (_ultimoResultadoMongo is not null)
    {
        <section class="card import-summary" style="margin-top: 14px;">
            <div class="section-title">
                <div>
                    <h2>Resumo do backup no MongoDB Atlas</h2>
                    <p>@_ultimoResultadoMongo.Mensagem</p>
                </div>
                <span class="badge @(_ultimoResultadoMongo.Sucesso ? "badge-positive" : "badge-negative")">
                    @(_ultimoResultadoMongo.Sucesso ? "Concluído" : "Erro")
                </span>
            </div>
            <div>
                @foreach (var tab in _ultimoResultadoMongo.Tabelas.Where(t => t.TotalRegistros > 0))
                {
                    <span>
                        <small>@tab.NomeColecao</small>
                        <strong>@tab.TotalRegistros</strong>
                    </span>
                }
                <span>
                    <small>TOTAL GERAL</small>
                    <strong>@_ultimoResultadoMongo.TotalGeralRegistros docs</strong>
                </span>
            </div>
        </section>
    }

    <!-- Danger Zone Card -->
    <section class="card danger-zone">
        <div class="section-title">
            <div>
                <h2 style="color: var(--danger);">Zona de risco</h2>
                <p>Ações irreversíveis sobre a base de dados. Proceda com cautela.</p>
            </div>
            <span class="badge badge-negative">Atenção</span>
        </div>

        <div>
            <span>
