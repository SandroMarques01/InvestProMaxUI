        _processando = true;
        _processandoMongo = true;
        try
        {
            _ultimoResultadoMongo = await ApiClient.ExecutarBackupMongoAsync();
            if (_ultimoResultadoMongo.Sucesso)
            {
                _mensagemSucesso = _ultimoResultadoMongo.Mensagem;
                await CarregarStatusMongoAsync();
            }
            else
            {
                _mensagemErro = _ultimoResultadoMongo.Mensagem;
            }
        }
        catch (Exception ex)
        {
            _mensagemErro = $"Falha ao executar backup no MongoDB: {ex.Message}";
        }
        finally
        {
            _processando = false;
            _processandoMongo = false;
        }
    }

