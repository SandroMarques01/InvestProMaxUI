    private IEnumerable<TransacaoImportadaDto> ObterTransacoesB3Filtradas()
    {
        if (_ultimoResultadoB3?.Transacoes is null) return Enumerable.Empty<TransacaoImportadaDto>();

        var itens = _ultimoResultadoB3.Transacoes.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_gridB3FiltroTipo) && Enum.TryParse<TipoTransacao>(_gridB3FiltroTipo, out var tipo))
        {
            itens = itens.Where(t => t.TipoTransacao == tipo);
        }

        if (!string.IsNullOrWhiteSpace(_gridB3Busca))
        {
            var termo = _gridB3Busca.Trim();
            itens = itens.Where(t =>
                t.Codigo.Contains(termo, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrEmpty(t.NomePapel) && t.NomePapel.Contains(termo, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrEmpty(t.Descricao) && t.Descricao.Contains(termo, StringComparison.OrdinalIgnoreCase)));
        }

        return _gridB3ColunaOrdenacao switch
        {
            "Data" => _gridB3OrdemAscendente ? itens.OrderBy(t => t.Data) : itens.OrderByDescending(t => t.Data),
            "Papel" => _gridB3OrdemAscendente ? itens.OrderBy(t => t.Codigo) : itens.OrderByDescending(t => t.Codigo),
            "Tipo" => _gridB3OrdemAscendente ? itens.OrderBy(t => t.TipoTransacao) : itens.OrderByDescending(t => t.TipoTransacao),
            "Quantidade" => _gridB3OrdemAscendente ? itens.OrderBy(t => t.Quantidade) : itens.OrderByDescending(t => t.Quantidade),
            "ValorUnitario" => _gridB3OrdemAscendente ? itens.OrderBy(t => t.ValorUnitario) : itens.OrderByDescending(t => t.ValorUnitario),
            "ValorTotal" => _gridB3OrdemAscendente ? itens.OrderBy(t => t.ValorTotal) : itens.OrderByDescending(t => t.ValorTotal),
            "Descricao" => _gridB3OrdemAscendente ? itens.OrderBy(t => t.Descricao) : itens.OrderByDescending(t => t.Descricao),
            _ => itens
        };
    }

