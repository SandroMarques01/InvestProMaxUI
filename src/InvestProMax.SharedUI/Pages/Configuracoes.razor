    private bool EhAdmin => string.Equals(AuthState.NomeUsuario, "admin", StringComparison.OrdinalIgnoreCase);

    private async Task ImportarAsync<T>(InputFileChangeEventArgs e, Func<Stream, string, CancellationToken, Task<T>> importar)
    {
        _mensagemErro = null;
        _mensagemSucesso = null;
        _ultimoResultadoB3 = null;
        _ultimoResultadoCotacoes = null;
        _ultimoResultadoRestauracao = null;
        _processando = true;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);

            var resultado = await importar(memoria, e.File.Name, CancellationToken.None);
            if (resultado is ImportarB3Response b3)
            {
                _ultimoResultadoB3 = b3;
                _mensagemSucesso = $"Importação concluída: {b3.PapeisCriados} papel(éis), {b3.TransacoesCriadas} transação(ões), {b3.DividendosCriados} dividendo(s), {b3.MovimentosAluguelCriados} movimento(s) de aluguel.";
            }
            else if (resultado is ImportarCotacoesResponse cotacoes)
            {
                _ultimoResultadoCotacoes = cotacoes;
                _mensagemSucesso = $"{cotacoes.CotacoesAtualizadas} cotação(ões) atualizada(s)." +
                    (cotacoes.CodigosNaoEncontrados.Count > 0 ? $" Não encontrados: {string.Join(", ", cotacoes.CodigosNaoEncontrados)}." : "");
            }
            else
            {
                _mensagemSucesso = "Importação concluída com sucesso.";
            }
        }
        catch (ApiException ex)
        {
            _mensagemErro = ex.Message;
        }
        finally
        {
            _processando = false;
        }
    }

    private async Task BaixarBackupAsync()
    {
        _mensagemErro = null;
        _processando = true;
        try
        {
            var (conteudo, nomeArquivo) = await ApiClient.BaixarBackupAsync();
            await using var stream = conteudo;
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);
            var base64 = Convert.ToBase64String(memoria.ToArray());
            await Js.InvokeVoidAsync("investProMaxDownloadFile", nomeArquivo, base64);
        }
        catch (ApiException ex)
        {
            _mensagemErro = ex.Message;
        }
        finally
        {
            _processando = false;
        }
    }

    private BackupMongoResponse? _ultimoResultadoMongo;
