<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>InvestProMax.SharedUI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versão: mesmo aviso das demais camadas sobre chute de versão de pacote.
         Só o essencial do Blazor (Components.Web + Authorization) — nenhuma dependência de
         WebAssembly ou MAUI aqui de propósito (seção 3: SharedUI é consumida por ambos os
         heads, não pode assumir o runtime de nenhum dos dois). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
  </ItemGroup>

</Project>
